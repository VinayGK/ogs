<?xml version="1.0" encoding="ISO-8859-1"?>
<OpenGeoSysProjectDiff base_file="double_porosity_swelling.prj">
    <!-- Run-only surrogate for BEACON 1c.
         Benchmark intent in BEACON: constant-volume block/pellet assembly with
         top wetting and different initial density zones. Current OGS surrogate:
         a fully confined single-medium RM/VK case with denser macro state and a
         stronger swelling response. It checks execution of a 1c-labeled setup,
         not reproduction of the block/pellet experiment. -->
    <add sel="/*/processes/process[1]">
        <vk_potential_exchange>
            <enabled>true</enabled>
            <mode>full_potential</mode>
            <pressure_tolerance>0.0</pressure_tolerance>
            <hamaker_constant>1e-30</hamaker_constant>
            <specific_surface>1.0</specific_surface>
            <micro_solid_density_reference>2650</micro_solid_density_reference>
            <micro_solid_volume_fraction_reference>0.6</micro_solid_volume_fraction_reference>
            <initial_micro_water_content>0.1</initial_micro_water_content>
            <fd_jacobian_for_exchange>false</fd_jacobian_for_exchange>
        </vk_potential_exchange>
    </add>

    <add sel="/*/process_variables/process_variable[name='displacement']/boundary_conditions">
        <boundary_condition>
            <geometrical_set>square_1x1_geometry</geometrical_set>
            <geometry>right</geometry>
            <type>Dirichlet</type>
            <component>0</component>
            <parameter>dirichlet0</parameter>
        </boundary_condition>
        <boundary_condition>
            <geometrical_set>square_1x1_geometry</geometrical_set>
            <geometry>top</geometry>
            <type>Dirichlet</type>
            <component>1</component>
            <parameter>dirichlet0</parameter>
        </boundary_condition>
    </add>

    <replace msel="/*/parameters/parameter[name='phi0']/value/text()">
        0.45
    </replace>
    <replace msel="/*/parameters/parameter[name='phi_tr0']/value/text()">
        0.3
    </replace>
    <replace msel="/*/media/medium/properties/property[name='permeability']/value/text()">
        1e-16
    </replace>
    <replace msel="/*/media/medium/phases/phase[type='Solid']/properties/property[name='swelling_stress_rate']/swelling_pressures/text()">
        1.3e7 1.3e7 1.3e7
    </replace>
    <replace msel="/*/parameters/parameter[name='pressure_ic']/values/text()">
        -8e6
    </replace>
    <replace msel="/*/parameters/parameter[name='dirichlet_pressure']/value/text()">
        -8e6
    </replace>
    <replace msel="/*/curves/curve[name='pressure_ramp']/coords/text()">
        0.0 1e3
    </replace>
    <replace msel="/*/curves/curve[name='pressure_ramp']/values/text()">
        1 1
    </replace>
    <replace msel="/*/time_loop/processes/process/time_stepping/t_end/text()">
        1e3
    </replace>
    <replace msel="/*/time_loop/processes/process/time_stepping/initial_dt/text()">
        10
    </replace>
    <replace msel="/*/time_loop/processes/process/time_stepping/maximum_dt/text()">
        100
    </replace>
    <replace msel="/*/time_loop/output/fixed_output_times/text()">
        1e3
    </replace>
    <replace msel="/*/time_loop/output/prefix/text()">
        beacon_1c_vk_smoke
    </replace>
</OpenGeoSysProjectDiff>
