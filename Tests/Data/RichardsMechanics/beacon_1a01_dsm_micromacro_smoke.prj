<?xml version="1.0" encoding="ISO-8859-1"?>
<OpenGeoSysProject>
<!--
  DSM provenance

  Several of the material parameters listed below have no identified
  literature source and are recorded as working values rather than
  measured or published quantities; each such entry is marked
  accordingly, with the numerical value given for reference.

  Benchmark family : Beacon (geometry lineage only). No BEACON
                     specification document with a table or figure
                     locator has been identified for this parameter set.
  Geometry / BC    : axisymmetric cell on beacon_1a01_domain.vtu, all four
                     boundaries roller constrained in their normal component
                     (fully confined), p_ic = -1e6 Pa suction, top_pressure
                     2e3 Pa, t_end = 1e3 s.
  Purpose          : micro-macro exchange plumbing smoke test. The Pi-path
                     potential is inactive (no augmentation prefactor is set
                     and the van der Waals term is switched off), so this
                     deck exercises the exchange machinery, not bentonite
                     physics.

  Calibration anchor:
    source         : none. This deck performs no calibration.
    dataset row    : n/a
    target sigma   : n/a
    fitted K       : none. No potential_augmentation_prefactor tag is
                     present, so K defaults to 0.0 and the augmentation
                     branch is skipped, reducing exactly to the plain van
                     der Waals form. The swelling_pressures values below
                     are inputs to the macro SaturationDependentSwelling
                     law; they are not calibration targets and should not
                     be read as an anchor row.

  Material parameters (source per group):
    elastic (E, nu)            : working value, no literature source
                                 identified (E = 50e6 Pa, nu = 0.2).
    porosity split phi0/phi_tr : working value, no literature source
                                 identified (0.4 / 0.3).
    intrinsic permeability     : working value, no literature source
                                 identified (1e-18 m2).
    retention macro (Sr,m,p_b) : working value, no literature source
                                 identified (0.0 / 0.5 / 1e6 Pa).
    retention micro (Sr,m,p_b) : working value, no literature source
                                 identified (0 / 0.5 / 1e7 Pa).
    swelling law (p_sw, expts) : working value, no literature source
                                 identified (1.3e7 Pa x3, 1 1 1).
    solid density rho_s        : working value, no literature source
                                 identified (2780 kg/m3). The EURAD-2 MS33
                                 specification text mentions a solid density
                                 of 2.78 g/cm3, but its parameter table does
                                 not tabulate this quantity, so that mention
                                 is not treated as a citable locator here.
                                 This value also differs from the
                                 micro-scale solid density used elsewhere in
                                 this file (2650 kg/m3), roughly a 4.7
                                 percent difference between the two grain
                                 densities.
    micro reference state      : working value, no literature source
                                 identified (rho_SR_m = 2650 kg/m3, nS_ref,
                                 n_l0). Note: 2650 kg/m3 coincides with a
                                 grain density reported for Boom clay
                                 (GRS-202); that source describes a
                                 different material and is not the basis
                                 for this value.
    fluid properties           : working value (viscosity 1e-3 Pa s,
                                 density 1e3 kg/m3), rounded rather than
                                 taken directly from the IAPWS-95 values at
                                 293.15 K (1.002e-3 Pa s, 998.21 kg/m3).
    biot_coefficient           : working value (1.0), representing an
                                 incompressible-mineral assumption rather
                                 than a measurement.
    mass transfer alpha_M      : working value (1e-13); phenomenological
                                 and fabric dependent, not identified by a
                                 swelling-pressure calibration.
    reference temperature      : working value (293.15 K; inert in these
                                 isothermal decks).
    BC / IC magnitudes         : working value. Suction initial condition,
                                 hydraulic Dirichlet values, sigma0 (zero)
                                 and the zero body force are uncited. The
                                 EURAD-2 MS33 specification uses an initial
                                 suction of 100 MPa, two orders of magnitude
                                 (100x) larger than the value used here, so
                                 these values are not inherited from that
                                 specification.
    macro_porosity_floor and
    micro_water_content_floor  : 0.0 / 0.0, numerical and inert; both keys
                                 are required by the parser, and a floor of
                                 0 reproduces the unfloored behaviour
                                 exactly.
    micro EOS (a, b, rho_l0)   : working value, no literature source
                                 identified.
    vdW base A_Hamaker         : numerical placeholder, term switched off.
                                 A = 1e-30 J paired with specific_surface =
                                 1.0 drives the prefactor A*Sa^3/(6*pi) to
                                 roughly 1e-19 of its physical value. An
                                 exact zero is rejected by a positivity
                                 guard in the parser, so this minimal
                                 positive pair is used to disable the term;
                                 the same pair of values is used in the
                                 corresponding unit-test harness. This is
                                 not a material parameter and no literature
                                 citation applies to it directly; the
                                 literature value it stands in for is
                                 A = 2.2e-20 J (Israelachvili and Adams
                                 1978).
    specific surface Sa        : 1.0 m2/kg, placeholder paired with A above
                                 (MX-80 bentonite specific surface is of
                                 order 1e5 to 1e6 m2/kg).

  Reference VTU    : regression baseline for this deck; not a physics claim
                     and not a validated result.

  Notes on this deck:
    1. bishops_effective_stress uses BishopsPowerLaw(exponent=1); an
       alternative saturation-cutoff formulation, BishopsSaturationCutoff
       (cutoff=1), is used in other decks in this benchmark set.
    2. The pressure absolute tolerance (5e-8 Pa) is set well below the
       suction scale (1e6 Pa), with no relative tolerance specified.
    3. Among the related beacon decks, the switched-off Hamaker-constant
       placeholder takes three different values (1e-30 / 6e-20 / 5.1e-21 J),
       none of which equals the literature value 2.2e-20 J (Israelachvili
       and Adams 1978).
    4. The unit of the alpha_M mass-transfer coefficient is not documented
       in the OGS parameter reference; none is asserted here.
-->
    <mesh axially_symmetric="true">beacon_1a01_domain.vtu</mesh>
    <geometry>beacon_1a01.gml</geometry>
    <processes>
        <process>
            <name>RM</name>
            <type>RICHARDS_MECHANICS</type>
            <integration_order>2</integration_order>
            <micro_porosity>
                <mass_exchange_coefficient>1e-13</mass_exchange_coefficient>
                <nonlinear_solver>
                    <maximum_iterations>100</maximum_iterations>
                    <residuum_tolerance>1e-8</residuum_tolerance>
                    <increment_tolerance>1e-20</increment_tolerance>
                </nonlinear_solver>
            </micro_porosity>
            <potential_exchange>
                <enabled>true</enabled>
                <pressure_tolerance>0.0</pressure_tolerance>
                <hamaker_constant>1e-30</hamaker_constant>
                <specific_surface>1.0</specific_surface>
                <micro_solid_density_reference>2650</micro_solid_density_reference>
                <micro_solid_volume_fraction_reference>0.6</micro_solid_volume_fraction_reference>
                <initial_micro_water_content>0.1</initial_micro_water_content>
                <fd_jacobian_for_exchange>false</fd_jacobian_for_exchange>
                            <!-- Floors declared inert (0.0 = no floor), preserving the
                     behaviour these decks were written under; both floor
                     keys are required by the parser. Same inert
                     declaration as the MS33 form (a) decks. -->
                <macro_porosity_floor>0.0</macro_porosity_floor>
                <micro_water_content_floor>0.0</micro_water_content_floor>
            </potential_exchange>
            <constitutive_relation>
                <type>LinearElasticIsotropic</type>
                <youngs_modulus>E</youngs_modulus>
                <poissons_ratio>nu</poissons_ratio>
            </constitutive_relation>
            <process_variables>
                <pressure>pressure</pressure>
                <displacement>displacement</displacement>
            </process_variables>
            <secondary_variables>
                <secondary_variable name="sigma"/>
                <secondary_variable name="swelling_stress"/>
                <secondary_variable name="epsilon"/>
                <secondary_variable name="velocity"/>
                <secondary_variable name="saturation"/>
                <secondary_variable name="porosity"/>
                <secondary_variable name="transport_porosity"/>
                <secondary_variable name="dry_density_solid"/>
                <secondary_variable name="micro_saturation"/>
                <secondary_variable name="micro_pressure"/>
            </secondary_variables>
            <specific_body_force>0 0</specific_body_force>
            <initial_stress>sigma0</initial_stress>
            <mass_lumping>true</mass_lumping>
        </process>
    </processes>
    <media>
        <medium id="0">
            <phases>
                <phase>
                    <type>AqueousLiquid</type>
                    <properties>
                        <property><name>viscosity</name><type>Constant</type><value>1e-3</value></property>
                        <property><name>density</name><type>Constant</type><value>1e3</value></property>
                    </properties>
                </phase>
                <phase>
                    <type>Solid</type>
                    <properties>
                        <property><name>density</name><type>Constant</type><value>2780</value></property>
                        <property>
                            <name>swelling_stress_rate</name>
                            <type>SaturationDependentSwelling</type>
                            <swelling_pressures>1.3e7 1.3e7 1.3e7</swelling_pressures>
                            <exponents>1 1 1</exponents>
                            <lower_saturation_limit>0</lower_saturation_limit>
                            <upper_saturation_limit>1</upper_saturation_limit>
                        </property>
                    </properties>
                </phase>
            </phases>
            <properties>
                <property><name>transport_porosity</name><type>TransportPorosityFromMassBalance</type><initial_porosity>phi_tr0</initial_porosity><minimal_porosity>0</minimal_porosity><maximal_porosity>1</maximal_porosity></property>
                <property><name>biot_coefficient</name><type>Constant</type><value>1.0</value></property>
                <property><name>permeability</name><type>Constant</type><value>1e-18</value></property>
                <property><name>porosity</name><type>PorosityFromMassBalance</type><initial_porosity>phi0</initial_porosity><minimal_porosity>0</minimal_porosity><maximal_porosity>1</maximal_porosity></property>
                <property><name>reference_temperature</name><type>Constant</type><value>293.15</value></property>
                <property><name>relative_permeability</name><type>Constant</type><value>1</value></property>
                <property><name>saturation</name><type>SaturationVanGenuchten</type><residual_liquid_saturation>0.0</residual_liquid_saturation><residual_gas_saturation>0</residual_gas_saturation><exponent>0.5</exponent><p_b>1e6</p_b></property>
                <property><name>saturation_micro</name><type>SaturationVanGenuchten</type><residual_liquid_saturation>0</residual_liquid_saturation><residual_gas_saturation>0</residual_gas_saturation><exponent>0.5</exponent><p_b>1e7</p_b></property>
                <property><name>bishops_effective_stress</name><type>BishopsPowerLaw</type><exponent>1</exponent></property>
            </properties>
        </medium>
    </media>
    <time_loop>
        <processes>
            <process ref="RM">
                <nonlinear_solver>nonlinear_solver</nonlinear_solver>
                <convergence_criterion>
                    <norm_type>NORM2</norm_type>
                    <type>PerComponentDeltaX</type>
                    <abstols>5e-8 1e-13 1e-13</abstols>
                </convergence_criterion>
                <time_discretization><type>BackwardEuler</type></time_discretization>
                <time_stepping>
                    <type>FixedTimeStepping</type>
                    <t_initial>0.0</t_initial>
                    <t_end>1e3</t_end>
                    <timesteps><pair><repeat>20</repeat><delta_t>50</delta_t></pair></timesteps>
                </time_stepping>
            </process>
        </processes>
        <output>
            <type>VTK</type>
            <prefix>beacon_1a01_dsm_micromacro_smoke</prefix>
            <suffix>_t_{:time}</suffix>
            <fixed_output_times>1e3</fixed_output_times>
            <variables><variable>pressure</variable><variable>displacement</variable><variable>saturation</variable><variable>micro_pressure</variable><variable>micro_saturation</variable><variable>swelling_stress</variable><variable>sigma</variable></variables>
        </output>
    </time_loop>
    <parameters>
        <parameter><name>sigma0</name><type>Function</type><expression>0</expression><expression>0</expression><expression>0</expression><expression>0</expression></parameter>
        <parameter><name>E</name><type>Constant</type><value>50e6</value></parameter>
        <parameter><name>nu</name><type>Constant</type><value>0.2</value></parameter>
        <parameter><name>phi0</name><type>Constant</type><value>0.4</value></parameter>
        <parameter><name>phi_tr0</name><type>Constant</type><value>0.3</value></parameter>
        <parameter><name>displacement0</name><type>Constant</type><values>0 0</values></parameter>
        <parameter><name>pressure_ic</name><type>Constant</type><values>-1e6</values></parameter>
        <parameter><name>dirichlet0</name><type>Constant</type><value>0</value></parameter>
        <parameter><name>top_pressure</name><type>Constant</type><value>2e3</value></parameter>
    </parameters>
    <process_variables>
        <process_variable>
            <name>displacement</name>
            <components>2</components>
            <order>1</order>
            <initial_condition>displacement0</initial_condition>
            <boundary_conditions>
                <boundary_condition><geometrical_set>beacon_1a01_geometry</geometrical_set><geometry>left</geometry><type>Dirichlet</type><component>0</component><parameter>dirichlet0</parameter></boundary_condition>
                <boundary_condition><geometrical_set>beacon_1a01_geometry</geometrical_set><geometry>right</geometry><type>Dirichlet</type><component>0</component><parameter>dirichlet0</parameter></boundary_condition>
                <boundary_condition><geometrical_set>beacon_1a01_geometry</geometrical_set><geometry>bottom</geometry><type>Dirichlet</type><component>1</component><parameter>dirichlet0</parameter></boundary_condition>
                <boundary_condition><geometrical_set>beacon_1a01_geometry</geometrical_set><geometry>top</geometry><type>Dirichlet</type><component>1</component><parameter>dirichlet0</parameter></boundary_condition>
            </boundary_conditions>
        </process_variable>
        <process_variable>
            <name>pressure</name>
            <components>1</components>
            <order>1</order>
            <initial_condition>pressure_ic</initial_condition>
            <boundary_conditions>
                <boundary_condition><geometrical_set>beacon_1a01_geometry</geometrical_set><geometry>top</geometry><type>Dirichlet</type><component>0</component><parameter>top_pressure</parameter></boundary_condition>
            </boundary_conditions>
        </process_variable>
    </process_variables>
    <nonlinear_solvers>
        <nonlinear_solver><name>nonlinear_solver</name><type>Newton</type><max_iter>30</max_iter><linear_solver>general_linear_solver</linear_solver></nonlinear_solver>
    </nonlinear_solvers>
    <linear_solvers>
        <linear_solver><name>general_linear_solver</name><eigen><solver_type>SparseLU</solver_type><scaling>true</scaling></eigen></linear_solver>
    </linear_solvers>
</OpenGeoSysProject>
