<?xml version="1.0" encoding="ISO-8859-1"?>
<OpenGeoSysProject>
    <mesh axially_symmetric="true">beacon_1c_domain.vtu</mesh>
    <geometry>beacon_1c.gml</geometry>
    <processes>
        <process>
            <name>RM</name>
            <type>RICHARDS_MECHANICS</type>
            <integration_order>2</integration_order>
            <constitutive_relation id="0">
                <type>MFrontRichardsMechanics</type>
                <behaviour>RichardsMechanicsNotebookBridge_MCC</behaviour>
                <material_properties>
                    <material_property name="YoungModulus" parameter="E"/>
                    <material_property name="PoissonRatio" parameter="nu"/>
                    <material_property name="CriticalStateLineSlope" parameter="CriticalStateLineSlope"/>
                    <material_property name="SwellingLineSlope" parameter="SwellingLineSlope"/>
                    <material_property name="VirginConsolidationLineSlope" parameter="VirginConsolidationLineSlope"/>
                    <material_property name="CharacteristicPreConsolidationPressure" parameter="InitialPreConsolidationPressure"/>
                    <material_property name="ResidualLiquidSaturation" parameter="ResidualLiquidSaturation"/>
                    <material_property name="ResidualGasSaturation" parameter="ResidualGasSaturation"/>
                    <material_property name="BubblePressure" parameter="BubblePressure_block"/>
                    <material_property name="VanGenuchtenExponent_m" parameter="VanGenuchtenExponent_m"/>
                    <material_property name="NotebookSaturationMode" parameter="NotebookSaturationMode"/>
                    <material_property name="SwellingSlope" parameter="NotebookSwellingSlope_block"/>
                    <material_property name="MassExchangeCoefficient" parameter="MassExchangeCoefficient_block"/>
                    <material_property name="ReferenceLiquidDensityMacro" parameter="ReferenceLiquidDensityMacro"/>
                    <material_property name="ReferenceLiquidDensityMicro" parameter="ReferenceLiquidDensityMicro_block"/>
                    <material_property name="ReferenceDensitySolid" parameter="ReferenceDensitySolid"/>
                    <material_property name="MicroLiquidDensityA" parameter="MicroLiquidDensityA_block"/>
                    <material_property name="MicroLiquidDensityB" parameter="MicroLiquidDensityB_block"/>
                    <material_property name="HamakerConstant" parameter="HamakerConstant"/>
                    <material_property name="SpecificSurface" parameter="SpecificSurface_block"/>
                    <material_property name="AreaFactorTuller" parameter="AreaFactorTuller"/>
                    <material_property name="PoreAreaShapeFactorTuller" parameter="PoreAreaShapeFactorTuller"/>
                    <material_property name="CharacteristicPoreSize" parameter="CharacteristicPoreSize"/>
                    <material_property name="SurfaceTension" parameter="SurfaceTension"/>
                    <material_property name="InitialPorosity" parameter="phi0_block"/>
                </material_properties>
                <initial_values>
                    <state_variable name="PreConsolidationPressure" parameter="InitialPreConsolidationPressure"/>
                    <state_variable name="VolumeRatio" parameter="InitialVolumeRatio_block"/>
                    <state_variable name="n_l" parameter="n_l0_block"/>
                    <state_variable name="rho_lR" parameter="rho_lR0_block"/>
                    <state_variable name="epsilon_sw" parameter="epsilon_sw0_block"/>
                </initial_values>
            </constitutive_relation>
            <constitutive_relation id="1">
                <type>MFrontRichardsMechanics</type>
                <behaviour>RichardsMechanicsNotebookBridge_MCC</behaviour>
                <material_properties>
                    <material_property name="YoungModulus" parameter="E"/>
                    <material_property name="PoissonRatio" parameter="nu"/>
                    <material_property name="CriticalStateLineSlope" parameter="CriticalStateLineSlope"/>
                    <material_property name="SwellingLineSlope" parameter="SwellingLineSlope"/>
                    <material_property name="VirginConsolidationLineSlope" parameter="VirginConsolidationLineSlope"/>
                    <material_property name="CharacteristicPreConsolidationPressure" parameter="InitialPreConsolidationPressure"/>
                    <material_property name="ResidualLiquidSaturation" parameter="ResidualLiquidSaturation"/>
                    <material_property name="ResidualGasSaturation" parameter="ResidualGasSaturation"/>
                    <material_property name="BubblePressure" parameter="BubblePressure_pellet"/>
                    <material_property name="VanGenuchtenExponent_m" parameter="VanGenuchtenExponent_m"/>
                    <material_property name="NotebookSaturationMode" parameter="NotebookSaturationMode"/>
                    <material_property name="SwellingSlope" parameter="NotebookSwellingSlope_pellet"/>
                    <material_property name="MassExchangeCoefficient" parameter="MassExchangeCoefficient_pellet"/>
                    <material_property name="ReferenceLiquidDensityMacro" parameter="ReferenceLiquidDensityMacro"/>
                    <material_property name="ReferenceLiquidDensityMicro" parameter="ReferenceLiquidDensityMicro_pellet"/>
                    <material_property name="ReferenceDensitySolid" parameter="ReferenceDensitySolid"/>
                    <material_property name="MicroLiquidDensityA" parameter="MicroLiquidDensityA_pellet"/>
                    <material_property name="MicroLiquidDensityB" parameter="MicroLiquidDensityB_pellet"/>
                    <material_property name="HamakerConstant" parameter="HamakerConstant"/>
                    <material_property name="SpecificSurface" parameter="SpecificSurface_pellet"/>
                    <material_property name="AreaFactorTuller" parameter="AreaFactorTuller"/>
                    <material_property name="PoreAreaShapeFactorTuller" parameter="PoreAreaShapeFactorTuller"/>
                    <material_property name="CharacteristicPoreSize" parameter="CharacteristicPoreSize"/>
                    <material_property name="SurfaceTension" parameter="SurfaceTension"/>
                    <material_property name="InitialPorosity" parameter="phi0_pellet"/>
                </material_properties>
                <initial_values>
                    <state_variable name="PreConsolidationPressure" parameter="InitialPreConsolidationPressure"/>
                    <state_variable name="VolumeRatio" parameter="InitialVolumeRatio_pellet"/>
                    <state_variable name="n_l" parameter="n_l0_pellet"/>
                    <state_variable name="rho_lR" parameter="rho_lR0_pellet"/>
                    <state_variable name="epsilon_sw" parameter="epsilon_sw0_pellet"/>
                </initial_values>
            </constitutive_relation>
            <process_variables><pressure>pressure</pressure><displacement>displacement</displacement></process_variables>
            <secondary_variables>
                <secondary_variable name="ElasticStrain"/><secondary_variable name="EquivalentPlasticStrain"/><secondary_variable name="PreConsolidationPressure"/><secondary_variable name="PlasticVolumetricStrain"/><secondary_variable name="sigma"/><secondary_variable name="swelling_stress"/><secondary_variable name="epsilon"/><secondary_variable name="velocity"/><secondary_variable name="saturation"/><secondary_variable name="porosity"/><secondary_variable name="transport_porosity"/><secondary_variable name="dry_density_solid"/><secondary_variable name="VolumeRatio"/><secondary_variable name="n_l"/><secondary_variable name="rho_lR"/><secondary_variable name="epsilon_sw"/><secondary_variable name="phi_m"/><secondary_variable name="phi_M"/><secondary_variable name="phi"/><secondary_variable name="n_S"/><secondary_variable name="n_L"/><secondary_variable name="rho_LR"/><secondary_variable name="omega_l"/><secondary_variable name="mu_lR"/><secondary_variable name="rho_l_hat"/><secondary_variable name="delta_epsilon_sw"/><secondary_variable name="sigma_S"/>
            </secondary_variables>
            <specific_body_force>0 0</specific_body_force>
            <initial_stress>sigma0</initial_stress>
            <explicit_hm_coupling_in_unsaturated_zone>false</explicit_hm_coupling_in_unsaturated_zone>
            <mass_lumping>true</mass_lumping>
        </process>
    </processes>
    <media>
        <medium id="0">
            <phases>
                <phase><type>AqueousLiquid</type><properties><property><name>viscosity</name><type>Constant</type><value>1e-3</value></property><property><name>density</name><type>Constant</type><value>1e3</value></property></properties></phase>
                <phase><type>Solid</type><properties><property><name>density</name><type>Constant</type><value>2780</value></property></properties></phase>
            </phases>
            <properties>
                <property><name>transport_porosity</name><type>TransportPorosityFromMassBalance</type><initial_porosity>phi_tr0_block</initial_porosity><minimal_porosity>0</minimal_porosity><maximal_porosity>1</maximal_porosity></property>
                <property><name>biot_coefficient</name><type>Constant</type><value>1.0</value></property>
                <property><name>permeability</name><type>Constant</type><value>1e-18</value></property>
                <property><name>porosity</name><type>PorosityFromMassBalance</type><initial_porosity>phi0_block</initial_porosity><minimal_porosity>0</minimal_porosity><maximal_porosity>1</maximal_porosity></property>
                <property><name>reference_temperature</name><type>Constant</type><value>293.15</value></property>
                <property><name>relative_permeability</name><type>Constant</type><value>1</value></property>
                <property><name>saturation</name><type>SaturationVanGenuchten</type><residual_liquid_saturation>0.0</residual_liquid_saturation><residual_gas_saturation>0</residual_gas_saturation><exponent>0.5</exponent><p_b>1e6</p_b></property>
                <property><name>bishops_effective_stress</name><type>BishopsSaturationCutoff</type><cutoff_value>1</cutoff_value></property>
            </properties>
        </medium>
        <medium id="1">
            <phases>
                <phase><type>AqueousLiquid</type><properties><property><name>viscosity</name><type>Constant</type><value>1e-3</value></property><property><name>density</name><type>Constant</type><value>1e3</value></property></properties></phase>
                <phase><type>Solid</type><properties><property><name>density</name><type>Constant</type><value>2780</value></property></properties></phase>
            </phases>
            <properties>
                <property><name>transport_porosity</name><type>TransportPorosityFromMassBalance</type><initial_porosity>phi_tr0_pellet</initial_porosity><minimal_porosity>0</minimal_porosity><maximal_porosity>1</maximal_porosity></property>
                <property><name>biot_coefficient</name><type>Constant</type><value>1.0</value></property>
                <property><name>permeability</name><type>Constant</type><value>1e-15</value></property>
                <property><name>porosity</name><type>PorosityFromMassBalance</type><initial_porosity>phi0_pellet</initial_porosity><minimal_porosity>0</minimal_porosity><maximal_porosity>1</maximal_porosity></property>
                <property><name>reference_temperature</name><type>Constant</type><value>293.15</value></property>
                <property><name>relative_permeability</name><type>Constant</type><value>1</value></property>
                <property><name>saturation</name><type>SaturationVanGenuchten</type><residual_liquid_saturation>0.0</residual_liquid_saturation><residual_gas_saturation>0</residual_gas_saturation><exponent>0.5</exponent><p_b>5e5</p_b></property>
                <property><name>bishops_effective_stress</name><type>BishopsSaturationCutoff</type><cutoff_value>1</cutoff_value></property>
            </properties>
        </medium>
    </media>
    <time_loop>
        <processes><process ref="RM"><nonlinear_solver>nonlinear_solver</nonlinear_solver><convergence_criterion><norm_type>NORM2</norm_type><type>PerComponentDeltaX</type><abstols>5e-8 1e-13 1e-13</abstols></convergence_criterion><time_discretization><type>BackwardEuler</type></time_discretization><time_stepping><type>FixedTimeStepping</type><t_initial>0.0</t_initial><t_end>1e3</t_end><timesteps><pair><repeat>20</repeat><delta_t>50</delta_t></pair></timesteps></time_stepping></process></processes>
        <output><type>VTK</type><prefix>beacon_1c_vk_notebook_mcc_bridge</prefix><suffix>_t_{:time}</suffix><fixed_output_times>1e3</fixed_output_times><variables><variable>pressure</variable><variable>displacement</variable><variable>saturation</variable><variable>porosity</variable><variable>transport_porosity</variable><variable>swelling_stress</variable><variable>sigma</variable><variable>EquivalentPlasticStrain</variable><variable>PreConsolidationPressure</variable><variable>PlasticVolumetricStrain</variable><variable>VolumeRatio</variable><variable>n_l</variable><variable>rho_lR</variable><variable>epsilon_sw</variable><variable>phi_m</variable><variable>phi_M</variable><variable>phi</variable><variable>n_S</variable><variable>n_L</variable><variable>rho_LR</variable><variable>omega_l</variable><variable>mu_lR</variable><variable>rho_l_hat</variable><variable>delta_epsilon_sw</variable><variable>sigma_S</variable></variables></output>
    </time_loop>
    <parameters>
        <parameter><name>sigma0</name><type>Function</type><expression>0</expression><expression>0</expression><expression>0</expression><expression>0</expression></parameter>
        <parameter><name>E</name><type>Constant</type><value>50e6</value></parameter>
        <parameter><name>nu</name><type>Constant</type><value>0.2</value></parameter>
        <parameter><name>phi0_block</name><type>Constant</type><value>0.35</value></parameter>
        <parameter><name>phi_tr0_block</name><type>Constant</type><value>0.25</value></parameter>
        <parameter><name>phi0_pellet</name><type>Constant</type><value>0.675</value></parameter>
        <parameter><name>phi_tr0_pellet</name><type>Constant</type><value>0.55</value></parameter>
        <parameter><name>displacement0</name><type>Constant</type><values>0 0</values></parameter>
        <parameter><name>pressure_ic</name><type>Constant</type><values>-1e6</values></parameter>
        <parameter><name>dirichlet0</name><type>Constant</type><value>0</value></parameter>
        <parameter><name>top_pressure</name><type>Constant</type><value>1e4</value></parameter>
        <parameter><name>bottom_pressure</name><type>Constant</type><value>0</value></parameter>
        <parameter><name>CriticalStateLineSlope</name><type>Constant</type><value>1.2</value></parameter>
        <parameter><name>SwellingLineSlope</name><type>Constant</type><value>6.6e-3</value></parameter>
        <parameter><name>VirginConsolidationLineSlope</name><type>Constant</type><value>7.7e-2</value></parameter>
        <parameter><name>InitialPreConsolidationPressure</name><type>Constant</type><value>1e10</value></parameter>
        <parameter><name>ResidualLiquidSaturation</name><type>Constant</type><value>0.0</value></parameter>
        <parameter><name>ResidualGasSaturation</name><type>Constant</type><value>0.0</value></parameter>
        <parameter><name>VanGenuchtenExponent_m</name><type>Constant</type><value>0.5</value></parameter>
        <parameter><name>NotebookSaturationMode</name><type>Constant</type><value>0</value></parameter>
        <parameter><name>ReferenceLiquidDensityMacro</name><type>Constant</type><value>1000.0</value></parameter>
        <parameter><name>ReferenceDensitySolid</name><type>Constant</type><value>2650.0</value></parameter>
        <parameter><name>HamakerConstant</name><type>Constant</type><value>1e-30</value></parameter>
        <parameter><name>AreaFactorTuller</name><type>Constant</type><value>1.0</value></parameter>
        <parameter><name>PoreAreaShapeFactorTuller</name><type>Constant</type><value>0.8584073464102069</value></parameter>
        <parameter><name>CharacteristicPoreSize</name><type>Constant</type><value>1e-5</value></parameter>
        <parameter><name>SurfaceTension</name><type>Constant</type><value>0.0715</value></parameter>
        <parameter><name>BubblePressure_block</name><type>Constant</type><value>1e6</value></parameter>
        <parameter><name>BubblePressure_pellet</name><type>Constant</type><value>5e5</value></parameter>
        <parameter><name>NotebookSwellingSlope_block</name><type>Constant</type><value>0.0</value></parameter>
        <parameter><name>NotebookSwellingSlope_pellet</name><type>Constant</type><value>0.0</value></parameter>
        <parameter><name>MassExchangeCoefficient_block</name><type>Constant</type><value>1e-13</value></parameter>
        <parameter><name>MassExchangeCoefficient_pellet</name><type>Constant</type><value>1e-13</value></parameter>
        <parameter><name>ReferenceLiquidDensityMicro_block</name><type>Constant</type><value>1300.0</value></parameter>
        <parameter><name>ReferenceLiquidDensityMicro_pellet</name><type>Constant</type><value>1300.0</value></parameter>
        <parameter><name>MicroLiquidDensityA_block</name><type>Constant</type><value>1.3</value></parameter>
        <parameter><name>MicroLiquidDensityA_pellet</name><type>Constant</type><value>1.3</value></parameter>
        <parameter><name>MicroLiquidDensityB_block</name><type>Constant</type><value>1.0</value></parameter>
        <parameter><name>MicroLiquidDensityB_pellet</name><type>Constant</type><value>1.0</value></parameter>
        <parameter><name>SpecificSurface_block</name><type>Constant</type><value>0.8</value></parameter>
        <parameter><name>SpecificSurface_pellet</name><type>Constant</type><value>1.5</value></parameter>
        <parameter><name>InitialVolumeRatio_block</name><type>Constant</type><value>1.5384615384615385</value></parameter>
        <parameter><name>InitialVolumeRatio_pellet</name><type>Constant</type><value>3.0769230769230771</value></parameter>
        <parameter><name>n_l0_block</name><type>Constant</type><value>0.08</value></parameter>
        <parameter><name>n_l0_pellet</name><type>Constant</type><value>0.14</value></parameter>
        <parameter><name>rho_lR0_block</name><type>Constant</type><value>2142.2722975249453</value></parameter>
        <parameter><name>rho_lR0_pellet</name><type>Constant</type><value>1874.7557787315332</value></parameter>
        <parameter><name>epsilon_sw0_block</name><type>Constant</type><value>0.0</value></parameter>
        <parameter><name>epsilon_sw0_pellet</name><type>Constant</type><value>0.0</value></parameter>
    </parameters>
    <process_variables>
        <process_variable><name>displacement</name><components>2</components><order>1</order><initial_condition>displacement0</initial_condition><boundary_conditions>
            <boundary_condition><geometrical_set>beacon_1c_geometry</geometrical_set><geometry>left</geometry><type>Dirichlet</type><component>0</component><parameter>dirichlet0</parameter></boundary_condition>
            <boundary_condition><geometrical_set>beacon_1c_geometry</geometrical_set><geometry>right</geometry><type>Dirichlet</type><component>0</component><parameter>dirichlet0</parameter></boundary_condition>
            <boundary_condition><geometrical_set>beacon_1c_geometry</geometrical_set><geometry>bottom</geometry><type>Dirichlet</type><component>1</component><parameter>dirichlet0</parameter></boundary_condition>
            <boundary_condition><geometrical_set>beacon_1c_geometry</geometrical_set><geometry>top</geometry><type>Dirichlet</type><component>1</component><parameter>dirichlet0</parameter></boundary_condition>
        </boundary_conditions></process_variable>
        <process_variable><name>pressure</name><components>1</components><order>1</order><initial_condition>pressure_ic</initial_condition><boundary_conditions>
            <boundary_condition><geometrical_set>beacon_1c_geometry</geometrical_set><geometry>top</geometry><type>Dirichlet</type><component>0</component><parameter>top_pressure</parameter></boundary_condition>
            <boundary_condition><geometrical_set>beacon_1c_geometry</geometrical_set><geometry>bottom</geometry><type>Dirichlet</type><component>0</component><parameter>bottom_pressure</parameter></boundary_condition>
        </boundary_conditions></process_variable>
    </process_variables>
    <nonlinear_solvers><nonlinear_solver><name>nonlinear_solver</name><type>Newton</type><max_iter>30</max_iter><linear_solver>general_linear_solver</linear_solver></nonlinear_solver></nonlinear_solvers>
    <linear_solvers><linear_solver><name>general_linear_solver</name><eigen><solver_type>SparseLU</solver_type><scaling>true</scaling></eigen></linear_solver></linear_solvers>
</OpenGeoSysProject>
