@DSL DefaultGenericBehaviour;
@Behaviour RichardsMechanicsDSMMicroMacroBridge;
@Author OpenGeoSys Community;
@Date 2026 / 03 / 24;
@Description {
Reduced dsm_micromacro-aligned RichardsMechanics bridge for the verified shared
pressure-history boundary. This bridge replaces the earlier logistic pressure
surrogate by a local microstate update using the hierarchical porosity split
(phi_M = (phi0-n_l)/(1-n_l), phi_m = n_l*(1-phi_M)), a reduced micro-liquid
EOS, a van-der-Waals micro potential in J/kg (dimensional fix: /rho_lR applied,
matching native PotentialExchange.h commit 0d579e8aeb), and an isotropic
swelling-stress update.  Active solid fraction uses evolving nS=(1-phi0)/(1-n_l)
instead of the initial constant 1-phi0.
}

@Gradient StrainStensor eps_to;
eps_to.setGlossaryName("Strain");

@Gradient real p_LR;
p_LR.setEntryName("LiquidPressure");

@Flux StressStensor sigma;
sigma.setGlossaryName("Stress");

@Flux real S_L;
S_L.setEntryName("Saturation");

@TangentOperatorBlocks{∂sigma∕∂Δeps_to, ∂sigma∕∂Δp_LR, ∂S_L∕∂Δeps_to,
                       ∂S_L∕∂Δp_LR};

@MaterialProperty stress E;
E.setGlossaryName("YoungModulus");
@MaterialProperty real nu;
nu.setGlossaryName("PoissonRatio");

@MaterialProperty real swelling_slope;
swelling_slope.setEntryName("SwellingSlope");
@MaterialProperty real mass_exchange_coefficient;
mass_exchange_coefficient.setEntryName("MassExchangeCoefficient");
@MaterialProperty real fluid_viscosity;
fluid_viscosity.setEntryName("FluidViscosity");
@MaterialProperty real rho_LR_ref;
rho_LR_ref.setEntryName("ReferenceLiquidDensityMacro");
@MaterialProperty real rho_l0;
rho_l0.setEntryName("ReferenceLiquidDensityMicro");
@MaterialProperty real rho_SR;
rho_SR.setEntryName("ReferenceDensitySolid");
@MaterialProperty real density_a;
density_a.setEntryName("MicroLiquidDensityA");
@MaterialProperty real density_b;
density_b.setEntryName("MicroLiquidDensityB");
@MaterialProperty real hamaker_constant;
hamaker_constant.setEntryName("HamakerConstant");
// A: Hamaker constant [J] for clay-water-clay; literature value
// 2.2e-20 J for montmorillonite-water-montmorillonite (Israelachvili &
// Adams 1978, J. Chem. Soc. Faraday Trans. I, vol. 74, p. 975, Table 2,
// SFA mica proxy; range 1-5e-20 J across DLVO smectite literature).
// DO NOT calibrate A. Only K (vdw_augmentation_prefactor) and lambda
// (vdw_augmentation_decay_length) below are calibrated to Villar.
// Ported from native ProcessLib/RichardsMechanics/ConstitutiveRelations/
// PotentialExchange.h lines 71-94.
@MaterialProperty real specific_surface;
specific_surface.setEntryName("SpecificSurface");
@MaterialProperty real vdw_augmentation_prefactor;
vdw_augmentation_prefactor.setEntryName("VdwAugmentationPrefactor");
// K [J/kg]: lumped exponential augmentation amplitude; calibrated to
// Villar swelling pressure (paper_DSM.tex Tab. msIII_vs_villar:
// K(rho_d=1400)=7654.9, K(1600)=29985.0, K(1800)=118582.6 J/kg).
// Set to 0 to disable augmentation (pure vdW base only).
@MaterialProperty real vdw_augmentation_decay_length;
vdw_augmentation_decay_length.setEntryName("VdwAugmentationDecayLength");
// lambda [m]: characteristic water-film thickness in the augmentation
// exponential exp(-h/lambda); calibrated to Villar (typical 7.5e-7 m).
@MaterialProperty real phi0;
phi0.setEntryName("InitialPorosity");
@MaterialProperty real area_factor_tuller;
area_factor_tuller.setEntryName("AreaFactorTuller");
@MaterialProperty real pore_area_shape_factor_tuller;
pore_area_shape_factor_tuller.setEntryName("PoreAreaShapeFactorTuller");
@MaterialProperty real characteristic_pore_size;
characteristic_pore_size.setEntryName("CharacteristicPoreSize");
@MaterialProperty real surface_tension;
surface_tension.setEntryName("SurfaceTension");

@StateVariable real n_l;
n_l.setEntryName("n_l");
@StateVariable real rho_lR;
rho_lR.setEntryName("rho_lR");
@StateVariable real epsilon_sw;
epsilon_sw.setEntryName("epsilon_sw");

@AuxiliaryStateVariable real phi_m;
phi_m.setEntryName("phi_m");
@AuxiliaryStateVariable real phi_M;
phi_M.setEntryName("phi_M");
@AuxiliaryStateVariable real mu_lR_value;
mu_lR_value.setEntryName("mu_lR");
@AuxiliaryStateVariable real rho_l_hat_value;
rho_l_hat_value.setEntryName("rho_l_hat");

@ProvidesTangentOperator;
@Integrator {
  constexpr const auto pi = 3.14159265358979323846;
  constexpr const auto pressure_tolerance = 1e-12;
  constexpr const auto minimum_n_l = 1e-14;
  constexpr const auto minimum_density_gap = 1e-12;
  // Finite-difference tangent probes around the benchmark equilibrium hit
  // round-off before 1e-12, which can trigger a spurious line-search failure
  // in an already converged microstate solve.
  constexpr const auto newton_tolerance = 1e-11;
  constexpr const auto max_iterations = 64;

  tfel::raise_if(phi0 <= 0.0 || phi0 >= 1.0,
                 "Invalid parameter: InitialPorosity must lie in (0,1).");
  tfel::raise_if(rho_LR_ref <= 0.0 || rho_l0 <= 0.0 || rho_SR <= 0.0,
                 "Invalid density parameter: all reference densities must be positive.");
  tfel::raise_if(specific_surface <= 0.0,
                 "Invalid parameter: SpecificSurface must be positive.");
  tfel::raise_if(vdw_augmentation_prefactor < 0.0,
                 "Invalid parameter: VdwAugmentationPrefactor must be >= 0.");
  tfel::raise_if(vdw_augmentation_prefactor > 0.0 &&
                     !(vdw_augmentation_decay_length > 0.0),
                 "Invalid parameter: VdwAugmentationDecayLength must be > 0 "
                 "when VdwAugmentationPrefactor > 0.");
  tfel::raise_if(characteristic_pore_size <= 0.0,
                 "Invalid parameter: CharacteristicPoreSize must be positive.");
  tfel::raise_if(surface_tension <= 0.0,
                 "Invalid parameter: SurfaceTension must be positive.");

  const auto lambda = computeLambda(E, nu);
  const auto mu = computeMu(E, nu);
  const auto bulk_modulus = E / (3.0 * (1.0 - 2.0 * nu));
  const auto p = p_LR + Δp_LR;
  const auto delta_epsilon_v = trace(Δeps_to);
  const auto zero_dt = std::abs(dt) < 1e-15;
  // Hierarchical porosity split: phi = phi_M + n_l*(1-phi_M)
  //   => phi_M = (phi - n_l)/(1 - n_l)
  //   => phi_m = n_l*(1 - phi_M) = n_l*(1 - phi0)/(1 - n_l)   [small-strain: phi ≈ phi0]
  // Using phi ≈ phi0 (small-strain / Biot alpha=1 approximation).
  const auto phi_M_from_nl = [&](double nl) {
    const auto nl_safe = std::max(minimum_n_l, nl);
    return std::clamp((phi0 - nl_safe) / (1.0 - nl_safe), 0.0, phi0);
  };
  const auto phi_m_from_nl = [&](double nl) {
    return nl * (1.0 - phi_M_from_nl(nl));
  };
  // [2026-05-26 PHYSICS FIX] active_nS now denotes the aggregate SOLID
  // fraction (V_solid/V_aggregate = 1 - n_l), NOT the aggregate VOLUME
  // fraction in REV (1 - phi_M = (1-phi0)/(1-n_l)). Rationale: the
  // gravimetric water content omega_l = m_water / m_solid requires the
  // mass of solid as the carrier. Per aggregate volume, m_solid =
  // (1-n_l)*V_aggregate*rho_SR; per REV, m_solid = (1-phi)*V_REV*rho_SR;
  // both give the same omega_l. The OLD definition (1-phi_M) produced
  // omega_l_code = n_l*(1-n_l)*rho_lR/((1-phi0)*rho_SR), which is
  // state-dependently off from the standard gravimetric content by
  // factor (1-n_l)^2/(1-phi0) (+80% dry side, -50% saturated side).
  // The same fix is applied in the native binary
  // (ProcessLib/RichardsMechanics/RichardsMechanicsFEM-impl.h).
  const auto active_nS_from_nl = [&](double nl) {
    const auto nl_safe = std::clamp(nl, minimum_n_l, 1.0 - minimum_n_l);
    return 1.0 - nl_safe;
  };

  const auto n_l_prev = n_l;
  const auto rho_lR_prev = rho_lR;
  const auto phi_m_prev = phi_m_from_nl(n_l_prev);
  // REV-scale micro liquid mass density: phi_m * rho_lR  [kg/m³_REV]
  // Matches native ScalarReferenceMassStorage: rho_l = phi_m * rho_lR (not n_l * rho_lR).
  const auto previous_mass = phi_m_prev * rho_lR_prev;
  // Effective exchange coefficient: alpha * rho_LR / mu  — matches native alpha_M_effective.
  const auto alpha_eff = mass_exchange_coefficient * rho_LR_ref /
                          std::max(fluid_viscosity, 1e-20);

  const auto saturation_from_pressure = [&](const auto p_arg) {
    if (p_arg < -pressure_tolerance)
    {
      const auto capillary_prefactor =
          4.0 * pore_area_shape_factor_tuller * surface_tension * surface_tension /
          (area_factor_tuller * characteristic_pore_size * characteristic_pore_size);
      const auto capillary_term = capillary_prefactor / (p_arg * p_arg);
      return 1.0 - std::exp(-capillary_term);
    }
    return 1.0;
  };

  const auto mu_macro_from_pressure = [&](const auto p_arg,
                                          const auto rho_macro_arg) {
    const auto rho_macro_safe =
        std::max(rho_macro_arg, rho_LR_ref + minimum_density_gap);
    return p_arg > -pressure_tolerance ? 0.0 : p_arg / rho_macro_safe;
  };

  // omega = n_l * rho_lR / (active_nS * rho_SR)  — gravimetric water content
  // Uses evolving active_nS = (1-phi0)/(1-n_l) from the hierarchical split.
  const auto omega_from_state = [&](const auto n_l_arg, const auto rho_lR_arg) {
    const auto nS = active_nS_from_nl(n_l_arg);
    return n_l_arg * rho_lR_arg / (nS * rho_SR);
  };

  const auto rho_micro_eos = [&](const auto n_l_arg, const auto rho_lR_arg) {
    const auto omega = std::max(omega_from_state(n_l_arg, rho_lR_arg), minimum_n_l);
    return rho_l0 * std::exp(-density_a * std::pow(omega, density_b)) + rho_LR_ref;
  };

  // vdW micro potential + lumped exponential augmentation [J/kg],
  // negative_attractive convention — matches native PotentialExchange.h
  // lines 71-94 (commit 0d579e8aeb dimensional fix, commit 8192021299
  // active_nS fix). For the augmentation theory see paper_DSM.tex; K and
  // lambda calibrated to Villar (DO NOT calibrate A).
  //
  //   mu_lR_vdW = -A * Sa^3 * nS^3 * rho_SR^3 / (6*pi * n_l^3 * rho_lR)   [J/kg]
  //   mu_lR_aug = -K * exp(-h/lambda),  h = n_l/(nS*rho_SR*Sa)            [J/kg]
  //   mu_lR     = mu_lR_vdW + mu_lR_aug                                    [J/kg]
  //
  // SIGN: negative_attractive means the vdW binding reduces micro chemical
  // potential below free water (mu_lR < 0). Both vdW and augmentation
  // share the negative sign factor.  Exchange:
  //   rho_l_hat = alpha * (mu_LR - mu_lR)
  //   mu_LR < 0 at suction; mu_lR < 0 (vdW + augmentation binding).
  //   When |mu_lR| > |mu_LR|: mu_LR - mu_lR > 0 → micro fills.
  //   When |mu_lR| < |mu_LR|: mu_LR - mu_lR < 0 → micro drains.
  //   Equilibrium: mu_LR = mu_lR (both negative, magnitudes equal).
  //
  // MAGNITUDE: direct nS-form avoids rho_lR power-counting ambiguity via omega.
  //   omega = n_l*rho_lR/(nS*rho_SR); (Sa/omega)^3 = Sa^3*(nS*rho_SR)^3/(n_l*rho_lR)^3
  //   Correct: A*rho_lR^2/(6pi) * (Sa/omega)^3 — not A/(6pi*rho_lR) * (Sa/omega)^3.
  //
  // K = 0 disables augmentation (legacy/parity-pure-vdW configurations).
  const auto mu_micro_from_state = [&](const auto n_l_arg, const auto rho_lR_arg) {
    const auto rho_lR_safe = std::max(rho_lR_arg, rho_LR_ref + minimum_density_gap);
    const auto nS = active_nS_from_nl(n_l_arg);
    const auto n_l_safe = std::max(n_l_arg, minimum_n_l);
    // vdW base term [J/kg]; negative_attractive: leading minus.
    const auto mu_vdW = -(hamaker_constant * specific_surface * specific_surface *
                          specific_surface / (6.0 * pi)) *
                        (nS * nS * nS * rho_SR * rho_SR * rho_SR) /
                        (n_l_safe * n_l_safe * n_l_safe * rho_lR_safe);  // J/kg
    // Lumped exponential augmentation [J/kg]: -K * exp(-h/lambda),
    // h = n_l/(nS*rho_SR*Sa). Same sign as vdW base.
    const auto mu_aug =
        (vdw_augmentation_prefactor > 0.0 && vdw_augmentation_decay_length > 0.0)
            ? -vdw_augmentation_prefactor *
                  std::exp(-n_l_safe / (vdw_augmentation_decay_length * nS *
                                        rho_SR * specific_surface))
            : 0.0;  // J/kg
    return mu_vdW + mu_aug;  // J/kg
  };

  const auto solve_microstate = [&](const auto p_arg,
                                    const auto delta_epsilon_v_arg,
                                    const auto n_l_prev_arg,
                                    const auto rho_lR_prev_arg,
                                    double& n_l_out,
                                    double& rho_lR_out,
                                    double& mu_lR_out,
                                    double& rho_l_hat_out) {
    const auto rho_macro_step =
        std::max(rho_lR_prev_arg, rho_LR_ref + minimum_density_gap);
    auto n_l_trial = std::clamp(n_l_prev_arg, minimum_n_l, phi0);
    auto rho_lR_trial = std::max(rho_lR_prev_arg, rho_LR_ref + minimum_density_gap);
    auto converged = false;

    const auto evaluate = [&](const auto n_l_arg,
                              const auto rho_lR_arg,
                              double& residual_1,
      double& residual_2,
      double& mu_lR_arg,
      double& rho_l_hat_arg) {
      const auto mu_LR_arg = mu_macro_from_pressure(p_arg, rho_macro_step);
      mu_lR_arg = mu_micro_from_state(n_l_arg, rho_lR_arg);
      // Exchange [kg/m³_REV/s]: alpha_eff = alpha * rho_LR / mu — matches native.
      rho_l_hat_arg = alpha_eff * (mu_LR_arg - mu_lR_arg);
      // REV-scale mass balance: phi_m * rho_lR (not n_l * rho_lR) — matches native.
      const auto phi_m_local = phi_m_from_nl(n_l_arg);
      residual_1 = phi_m_local * rho_lR_arg - previous_mass - dt * rho_l_hat_arg -
                   phi_m_local * rho_lR_arg * delta_epsilon_v_arg;
      residual_2 = rho_lR_arg - rho_micro_eos(n_l_arg, rho_lR_arg);
    };

    const auto solve_rho_for_n_l = [&](const auto n_l_arg,
                                       const auto rho_initial_guess,
                                       double& rho_lR_out_arg) {
      auto rho_lR_trial_local =
          std::max(rho_initial_guess, rho_LR_ref + minimum_density_gap);

      for (unsigned int iteration = 0; iteration < 4 * max_iterations;
           ++iteration)
      {
        const auto rho_candidate = rho_micro_eos(n_l_arg, rho_lR_trial_local);
        const auto rho_change = std::abs(rho_candidate - rho_lR_trial_local);
        rho_lR_trial_local = std::max(rho_candidate, rho_LR_ref + minimum_density_gap);

        if (rho_change <
            newton_tolerance * std::max(1.0, std::abs(rho_lR_trial_local)))
        {
          rho_lR_out_arg = rho_lR_trial_local;
          return true;
        }
      }

      rho_lR_out_arg = rho_lR_trial_local;
      return false;
    };

    const auto evaluate_reduced = [&](const auto n_l_arg,
                                      const auto rho_initial_guess,
                                      double& residual_1,
                                      double& rho_lR_arg,
                                      double& mu_lR_arg,
                                      double& rho_l_hat_arg) {
      const auto rho_converged =
          solve_rho_for_n_l(n_l_arg, rho_initial_guess, rho_lR_arg);
      const auto mu_LR_arg = mu_macro_from_pressure(p_arg, rho_macro_step);
      mu_lR_arg = mu_micro_from_state(n_l_arg, rho_lR_arg);
      rho_l_hat_arg = alpha_eff * (mu_LR_arg - mu_lR_arg);
      const auto phi_m_red = phi_m_from_nl(n_l_arg);
      residual_1 =
          phi_m_red * rho_lR_arg - previous_mass - dt * rho_l_hat_arg -
          phi_m_red * rho_lR_arg * delta_epsilon_v_arg;
      return rho_converged;
    };

    const auto solve_microstate_bracketed =
        [&](double& n_l_bracketed_out,
            double& rho_lR_bracketed_out,
            double& mu_lR_bracketed_out,
            double& rho_l_hat_bracketed_out) {
          constexpr const auto bracket_scan_points = 256u;
          auto n_l_lo = minimum_n_l;
          auto n_l_hi = std::max(phi0, std::max(n_l_prev_arg, minimum_n_l * 10.0));

          double residual_lo = 0.0;
          double residual_hi = 0.0;
          double rho_lo = 0.0;
          double rho_hi = 0.0;
          double mu_lo = 0.0;
          double mu_hi = 0.0;
          double rho_hat_lo = 0.0;
          double rho_hat_hi = 0.0;

          auto bracket_ok =
              evaluate_reduced(n_l_lo, rho_lR_prev_arg, residual_lo, rho_lo,
                               mu_lo, rho_hat_lo) &&
              evaluate_reduced(n_l_hi, rho_lR_prev_arg, residual_hi, rho_hi,
                               mu_hi, rho_hat_hi);

          if (!bracket_ok)
          {
            return false;
          }

          if (residual_lo * residual_hi > 0.0)
          {
            const auto log_n_l_min = std::log10(minimum_n_l);
            const auto log_n_l_max = std::log10(n_l_hi);
            auto previous_n_l = n_l_lo;
            auto previous_residual = residual_lo;
            auto previous_rho = rho_lo;
            auto previous_mu = mu_lo;
            auto previous_rho_hat = rho_hat_lo;
            auto found_bracket = false;

            for (unsigned int i = 1; i <= bracket_scan_points; ++i)
            {
              const auto log_n_l =
                  log_n_l_min +
                  (log_n_l_max - log_n_l_min) *
                      (static_cast<double>(i) / bracket_scan_points);
              const auto n_l_candidate = std::pow(10.0, log_n_l);

              double residual_candidate = 0.0;
              double rho_candidate = 0.0;
              double mu_candidate = 0.0;
              double rho_hat_candidate = 0.0;
              if (!evaluate_reduced(n_l_candidate, rho_lR_prev_arg,
                                    residual_candidate, rho_candidate,
                                    mu_candidate, rho_hat_candidate))
              {
                return false;
              }

              if (previous_residual * residual_candidate <= 0.0)
              {
                n_l_lo = previous_n_l;
                residual_lo = previous_residual;
                rho_lo = previous_rho;
                mu_lo = previous_mu;
                rho_hat_lo = previous_rho_hat;

                n_l_hi = n_l_candidate;
                residual_hi = residual_candidate;
                rho_hi = rho_candidate;
                mu_hi = mu_candidate;
                rho_hat_hi = rho_hat_candidate;
                found_bracket = true;
                break;
              }

              previous_n_l = n_l_candidate;
              previous_residual = residual_candidate;
              previous_rho = rho_candidate;
              previous_mu = mu_candidate;
              previous_rho_hat = rho_hat_candidate;
            }

            if (!found_bracket)
            {
              return false;
            }
          }

          for (unsigned int iteration = 0; iteration < 4 * max_iterations;
               ++iteration)
          {
            const auto n_l_mid = 0.5 * (n_l_lo + n_l_hi);
            double residual_mid = 0.0;
            double rho_mid = 0.0;
            double mu_mid = 0.0;
            double rho_hat_mid = 0.0;

            if (!evaluate_reduced(n_l_mid, rho_lR_prev_arg, residual_mid,
                                  rho_mid, mu_mid, rho_hat_mid))
            {
              return false;
            }

            if (std::abs(residual_mid) < newton_tolerance ||
                std::abs(n_l_hi - n_l_lo) <
                    newton_tolerance * std::max(1.0, std::abs(n_l_mid)))
            {
              n_l_bracketed_out = n_l_mid;
              rho_lR_bracketed_out = rho_mid;
              mu_lR_bracketed_out = mu_mid;
              rho_l_hat_bracketed_out = rho_hat_mid;
              return true;
            }

            if (residual_lo * residual_mid <= 0.0)
            {
              n_l_hi = n_l_mid;
              residual_hi = residual_mid;
            }
            else
            {
              n_l_lo = n_l_mid;
              residual_lo = residual_mid;
            }
          }

          const auto n_l_mid = 0.5 * (n_l_lo + n_l_hi);
          double residual_mid = 0.0;
          double rho_mid = 0.0;
          double mu_mid = 0.0;
          double rho_hat_mid = 0.0;
          if (!evaluate_reduced(n_l_mid, rho_lR_prev_arg, residual_mid,
                                rho_mid, mu_mid, rho_hat_mid))
          {
            return false;
          }

          n_l_bracketed_out = n_l_mid;
          rho_lR_bracketed_out = rho_mid;
          mu_lR_bracketed_out = mu_mid;
          rho_l_hat_bracketed_out = rho_hat_mid;
          return true;
        };

    for (unsigned int iteration = 0; iteration < max_iterations; ++iteration)
    {
      double residual_1 = 0.0;
      double residual_2 = 0.0;
      double mu_lR_trial = 0.0;
      double rho_l_hat_trial = 0.0;
      evaluate(n_l_trial, rho_lR_trial, residual_1, residual_2, mu_lR_trial,
               rho_l_hat_trial);

      const auto residual_norm = std::abs(residual_1) + std::abs(residual_2);
      if (residual_norm < newton_tolerance)
      {
        n_l_out = n_l_trial;
        rho_lR_out = rho_lR_trial;
        mu_lR_out = mu_lR_trial;
        rho_l_hat_out = rho_l_hat_trial;
        converged = true;
        break;
      }

      // Analytical Jacobian (F5a port from native
      // ProcessLib/RichardsMechanics/RichardsMechanicsFEM-impl.h
      // ~lines 656-669; uses analytical dmu_lR_dnl, dmu_lR_drho_lR
      // exposed in PotentialExchange.h lines 174-175 after the /rho_lR
      // dimensional fix at commit 0d579e8aeb).
      //
      // r1 = phi_m(n_l)*rho_lR - prev_mass - dt*alpha_eff*(mu_LR - mu_lR(n_l,rho_lR))
      //        - phi_m(n_l)*rho_lR*delta_eps_v
      // r2 = rho_lR - rho_micro_eos(n_l, rho_lR)
      //
      // Derivatives treat active_nS = 1 - n_l (post-2026-05-26 fix), so nS
      // is an implicit function of n_l. Total derivatives (chain rule):
      //   dphi_m/dn_l      = (1-phi0)/(1-n_l)^2                       (unclamped)
      //   dmu_vdW/dn_l     = -3*mu_vdW/(n_l*nS)                        [J/kg per 1]
      //   dmu_vdW/drho_lR  = -mu_vdW/rho_lR                            [J/kg per kg/m^3]
      //   dmu_aug/dn_l     = -mu_aug/(lambda*nS^2*rho_SR*Sa)           [J/kg per 1]
      //   dmu_aug/drho_lR  = 0
      //   drho_eos/dn_l    = -(rho_eos-rho_LR_ref)*a*b*omega^(b-1)*rho_lR/(rho_SR*nS^2)
      //   drho_eos/drho_lR = -(rho_eos-rho_LR_ref)*a*b*omega^(b-1)*n_l/(nS*rho_SR)
      const auto n_l_jac = std::max(n_l_trial, minimum_n_l);
      const auto rho_lR_jac =
          std::max(rho_lR_trial, rho_LR_ref + minimum_density_gap);
      const auto nS_jac = active_nS_from_nl(n_l_jac);
      const auto one_minus_n_l_jac = std::max(1e-12, 1.0 - n_l_jac);
      const auto phi_m_jac = phi_m_from_nl(n_l_jac);
      // dphi_m/dn_l = (1-phi0)/(1-n_l)^2; flat zero when phi_M is clamped to
      // [0, phi0]. Clamps engage only at n_l <= 0 or n_l >= phi0, both outside
      // the iterate domain [minimum_n_l, phi0]; the unclamped form is safe.
      const auto dphi_m_dnl =
          (1.0 - phi0) / (one_minus_n_l_jac * one_minus_n_l_jac);  // 1
      // vdW + augmentation split for analytical derivatives.
      const auto mu_vdW_jac =
          -(hamaker_constant * specific_surface * specific_surface *
            specific_surface / (6.0 * pi)) *
          (nS_jac * nS_jac * nS_jac * rho_SR * rho_SR * rho_SR) /
          (n_l_jac * n_l_jac * n_l_jac * rho_lR_jac);  // J/kg
      const bool aug_active = (vdw_augmentation_prefactor > 0.0 &&
                               vdw_augmentation_decay_length > 0.0);
      const auto mu_aug_jac =
          aug_active
              ? -vdw_augmentation_prefactor *
                    std::exp(-n_l_jac /
                             (vdw_augmentation_decay_length * nS_jac *
                              rho_SR * specific_surface))
              : 0.0;  // J/kg
      const auto dmu_lR_dnl =
          -3.0 * mu_vdW_jac / (n_l_jac * nS_jac) +
          (aug_active
               ? -mu_aug_jac / (vdw_augmentation_decay_length * nS_jac *
                                nS_jac * rho_SR * specific_surface)
               : 0.0);  // J/kg per 1
      const auto dmu_lR_drho_lR = -mu_vdW_jac / rho_lR_jac;  // J/kg per kg/m^3
      // rho_eos chain rule
      const auto omega_raw = n_l_jac * rho_lR_jac / (nS_jac * rho_SR);
      const auto omega_clamped = std::max(omega_raw, minimum_n_l);
      const auto EOS_attractive =
          rho_l0 * std::exp(-density_a * std::pow(omega_clamped, density_b));  // kg/m^3
      const auto domega_dnl_jac =
          (omega_raw > minimum_n_l)
              ? rho_lR_jac / (rho_SR * nS_jac * nS_jac)
              : 0.0;  // 1 per 1
      const auto domega_drho_lR_jac =
          (omega_raw > minimum_n_l)
              ? n_l_jac / (nS_jac * rho_SR)
              : 0.0;  // 1 per kg/m^3
      const auto deos_prefactor =
          -EOS_attractive * density_a * density_b *
          std::pow(omega_clamped, density_b - 1.0);  // kg/m^3 per 1
      const auto drho_eos_dnl = deos_prefactor * domega_dnl_jac;  // kg/m^3
      const auto drho_eos_drho_lR = deos_prefactor * domega_drho_lR_jac;  // 1
      // Assemble Jacobian. delta_eps_v captured from solve_microstate args.
      const auto one_minus_deps_v = 1.0 - delta_epsilon_v_arg;
      const auto j11 =
          dphi_m_dnl * rho_lR_jac * one_minus_deps_v +
          dt * alpha_eff * dmu_lR_dnl;  // kg/m^3 per 1
      const auto j12 =
          phi_m_jac * one_minus_deps_v +
          dt * alpha_eff * dmu_lR_drho_lR;  // 1 (i.e., kg/m^3 per kg/m^3)
      const auto j21 = -drho_eos_dnl;  // kg/m^3 per 1
      const auto j22 = 1.0 - drho_eos_drho_lR;  // 1
      const auto determinant = j11 * j22 - j12 * j21;
      tfel::raise_if(std::abs(determinant) < 1e-24,
                     "DSMMicroMacro bridge microstate Newton system became singular.");

      const auto delta_n_l = (-residual_1 * j22 + j12 * residual_2) / determinant;
      const auto delta_rho = (j21 * residual_1 - j11 * residual_2) / determinant;

      auto damping = 1.0;
      auto accepted = false;
      while (damping > 1e-6)
      {
        // Clamp to [minimum_n_l, phi0]: n_l cannot exceed total porosity.
        // Matches native ceiling = phi (≈ phi0 in small-strain).
        const auto n_l_candidate =
            std::clamp(n_l_trial + damping * delta_n_l, minimum_n_l, phi0);
        const auto rho_candidate =
            std::max(rho_lR_trial + damping * delta_rho,
                     rho_LR_ref + minimum_density_gap);

        double candidate_residual_1 = 0.0;
        double candidate_residual_2 = 0.0;
        double dummy_mu = 0.0;
        double dummy_rho_hat = 0.0;
        evaluate(n_l_candidate, rho_candidate, candidate_residual_1,
                 candidate_residual_2, dummy_mu, dummy_rho_hat);
        const auto candidate_norm =
            std::abs(candidate_residual_1) + std::abs(candidate_residual_2);

        if (candidate_norm < residual_norm)
        {
          n_l_trial = n_l_candidate;
          rho_lR_trial = rho_candidate;
          accepted = true;
          break;
        }
        damping *= 0.5;
      }

      if (!accepted)
      {
        if (solve_microstate_bracketed(n_l_out, rho_lR_out, mu_lR_out,
                                       rho_l_hat_out))
        {
          converged = true;
          break;
        }
        // Bracketed solver failed: check if physics demands n_l > phi0
        // (saturation-clamped state). Evaluate residual at ceiling n_l = phi0.
        // If residual <= 0, all feasible n_l produce negative residual, meaning
        // micro pore space cannot absorb enough mass — clamp to phi0.
        // This matches native behavior: n_l = clamp(n_l, floor, phi_ceiling).
        {
          double res_ceil = 0.0;
          double rho_ceil = 0.0;
          double mu_ceil = 0.0;
          double rho_hat_ceil = 0.0;
          evaluate_reduced(phi0, rho_lR_prev_arg, res_ceil, rho_ceil, mu_ceil,
                           rho_hat_ceil);
          if (res_ceil <= 0.0)
          {
            n_l_out = phi0;
            rho_lR_out = rho_ceil;
            mu_lR_out = mu_ceil;
            rho_l_hat_out = rho_hat_ceil;
            converged = true;
            break;
          }
        }
        tfel::raise_if(true,
                       "DSMMicroMacro bridge microstate Newton line search failed.");
      }
    }

    if (!converged)
    {
      if (solve_microstate_bracketed(n_l_out, rho_lR_out, mu_lR_out,
                                     rho_l_hat_out))
      {
        return;
      }

      // Final fallback: saturation clamp identical to line-search fallback above.
      {
        double res_ceil = 0.0;
        double rho_ceil = 0.0;
        double mu_ceil = 0.0;
        double rho_hat_ceil = 0.0;
        evaluate_reduced(phi0, rho_lR_prev_arg, res_ceil, rho_ceil, mu_ceil,
                         rho_hat_ceil);
        if (res_ceil <= 0.0)
        {
          n_l_out = phi0;
          rho_lR_out = rho_ceil;
          mu_lR_out = mu_ceil;
          rho_l_hat_out = rho_hat_ceil;
          return;
        }
      }

      tfel::raise_if(true,
                     "DSMMicroMacro bridge microstate Newton solve did not converge.");
    }
  };

  double n_l_trial = n_l_prev;
  double rho_lR_trial = rho_lR_prev;
  double mu_lR_trial = mu_micro_from_state(n_l_prev, rho_lR_prev);
  double rho_l_hat_trial =
      mass_exchange_coefficient *
      (mu_macro_from_pressure(p, rho_lR_prev) - mu_lR_trial);
  if (!zero_dt)
  {
    solve_microstate(p, delta_epsilon_v, n_l_prev, rho_lR_prev, n_l_trial,
                     rho_lR_trial, mu_lR_trial, rho_l_hat_trial);
  }

  // Hierarchical porosity split applied at solved n_l:
  const auto phi_m_trial = phi_m_from_nl(n_l_trial);
  const auto phi_M_trial = phi_M_from_nl(n_l_trial);

  // Swelling stress increment. Mirrors native
  // RichardsMechanicsFEM-impl.h ~lines 1525-1567 (legacy path):
  //   K>0 && lambda>0 (augmentation enabled):
  //     Δσ_sw = n_S_rev * (n_l_prev * Π_prev - n_l_trial * Π_curr) * I_2
  //     with Π = ρ_LR_macro * K * exp(-ξ),
  //          ξ = n_l / (λ * n_S_rev * ρ_SR * Sa),
  //          n_S_rev = 1 - φ_M (REV-scale solid fraction — DISTINCT from
  //          active_nS = 1 - n_l used as the omega_l denominator).
  //     This is the thermodynamic eigenstress (tension-positive convention);
  //     the empirical slope formula is bypassed.
  //   else if SwellingSlope > 0:
  //     Δσ_sw = -K_bulk * slope * (φ_m - φ_m_prev) * I_2 (legacy slope path).
  //   else:
  //     Δσ_sw = 0.
  Stensor delta_sigma_sw_tensor;
  delta_sigma_sw_tensor = Stensor::Id() * 0.0;
  auto delta_epsilon_sw = real{0};
  const auto aug_stress_enabled =
      (vdw_augmentation_prefactor > 0.0 &&
       vdw_augmentation_decay_length > 0.0);
  if (aug_stress_enabled)
  {
    const auto nS_rev_stress =
        std::max(minimum_n_l, 1.0 - phi_M_trial);
    // Π in native uses the MACRO liquid density (rho_LR), not the micro
    // density (rho_lR). rho_lR_prev was a porting bug (the trace
    // diff-by-step revealed rho_LR_native=1000 vs mfront-prev=1100).
    // mfront's macro density is a constant material property =
    // rho_LR_ref (ReferenceLiquidDensityMacro). Use it directly.
    const auto rho_LR_macro_safe_stress = rho_LR_ref;
    const auto aug_denom_stress =
        vdw_augmentation_decay_length * nS_rev_stress * rho_SR *
        specific_surface;
    const auto xi_curr_stress = n_l_trial / aug_denom_stress;
    const auto xi_prev_stress = n_l_prev / aug_denom_stress;
    const auto Pi_curr_stress = rho_LR_macro_safe_stress *
                                vdw_augmentation_prefactor *
                                std::exp(-xi_curr_stress);  // Pa
    const auto Pi_prev_stress = rho_LR_macro_safe_stress *
                                vdw_augmentation_prefactor *
                                std::exp(-xi_prev_stress);  // Pa
    const auto delta_sigma_aug_scalar =
        nS_rev_stress *
        (n_l_prev * Pi_prev_stress - n_l_trial * Pi_curr_stress);  // Pa
    delta_sigma_sw_tensor = delta_sigma_aug_scalar * I₂;
    // delta_epsilon_sw stays 0 — stress derives from the augmentation
    // potential, not a kinematic swelling strain.
  }
  else if (swelling_slope > 0.0)
  {
    delta_epsilon_sw = swelling_slope * (phi_m_trial - phi_m_prev);
    delta_sigma_sw_tensor = -bulk_modulus * delta_epsilon_sw * I₂;
  }

  sigma = sigma + lambda * trace(Δeps_to) * I₂ + 2.0 * mu * Δeps_to +
          delta_sigma_sw_tensor;
  S_L = saturation_from_pressure(p);

  n_l = n_l_trial;
  rho_lR = rho_lR_trial;
  epsilon_sw = epsilon_sw + delta_epsilon_sw;
  phi_m = phi_m_trial;
  phi_M = phi_M_trial;
  mu_lR_value = mu_lR_trial;
  rho_l_hat_value = rho_l_hat_trial;

  if (computeTangentOperator_)
  {
    ∂sigma∕∂Δeps_to = lambda * (I₂ ⊗ I₂) + 2.0 * mu * I₄;
    ∂S_L∕∂Δeps_to = 0.0 * I₂;

    if (zero_dt)
    {
      if (p > -pressure_tolerance)
      {
        ∂sigma∕∂Δp_LR = 0.0 * I₂;
        ∂S_L∕∂Δp_LR = 0.0;
      }
      else
      {
        const auto dp_fd = std::max(1e-6, std::abs(p) * 1e-6);
        const auto dS_dp =
            (saturation_from_pressure(p + dp_fd) - saturation_from_pressure(p - dp_fd)) /
            (2.0 * dp_fd);
        ∂sigma∕∂Δp_LR = 0.0 * I₂;
        ∂S_L∕∂Δp_LR = dS_dp;
      }
    }
    else
    {
      // Analytical outer tangent (F5b port). Use the implicit-function theorem
      // on the converged microstate to compute dn_l/deps_v and dn_l/dp without
      // FD-perturbing solve_microstate. The Jacobian J = ∂(r1,r2)/∂(n_l,rho_lR)
      // is the same as the inner-Newton Jacobian, re-evaluated at the converged
      // (n_l_trial, rho_lR_trial).
      //
      // External-variable derivatives of the residuals:
      //   ∂r1/∂eps_v = -phi_m * rho_lR              (from the -phi_m*rho_lR*Δeps_v term)
      //   ∂r2/∂eps_v = 0                            (r2 has no eps_v dependence)
      //   ∂r1/∂p     = -dt*alpha_eff/rho_macro_safe (when p < -tol, via mu_LR = p/rho_macro)
      //   ∂r2/∂p     = 0                            (rho_micro_eos uses ref macro density)
      //
      // IFT: J · [dn_l/dx; drho_lR/dx] = -[∂r1/∂x; ∂r2/∂x]
      // Cramer:   dn_l/dx = (-∂r1/∂x · J22 + ∂r2/∂x · J12) / det(J)
      //
      // dS_L/dp uses the analytical Tuller derivative:
      //   S_L = 1 - exp(-C/p²),  C = 4·β·σ²/(α·L²)
      //   dS_L/dp = -2·(1-S_L)·C / p³

      // Recompute analytical Jacobian at the converged state.
      const auto n_l_jt = std::max(n_l_trial, minimum_n_l);
      const auto rho_lR_jt =
          std::max(rho_lR_trial, rho_LR_ref + minimum_density_gap);
      const auto nS_jt = active_nS_from_nl(n_l_jt);
      const auto one_minus_n_l_jt = std::max(1e-12, 1.0 - n_l_jt);
      const auto phi_m_jt = phi_m_from_nl(n_l_jt);
      const auto dphi_m_dnl_jt =
          (1.0 - phi0) / (one_minus_n_l_jt * one_minus_n_l_jt);  // 1
      const auto mu_vdW_jt =
          -(hamaker_constant * specific_surface * specific_surface *
            specific_surface / (6.0 * pi)) *
          (nS_jt * nS_jt * nS_jt * rho_SR * rho_SR * rho_SR) /
          (n_l_jt * n_l_jt * n_l_jt * rho_lR_jt);  // J/kg
      const bool aug_active_jt = (vdw_augmentation_prefactor > 0.0 &&
                                  vdw_augmentation_decay_length > 0.0);
      const auto mu_aug_jt =
          aug_active_jt
              ? -vdw_augmentation_prefactor *
                    std::exp(-n_l_jt /
                             (vdw_augmentation_decay_length * nS_jt *
                              rho_SR * specific_surface))
              : 0.0;  // J/kg
      const auto dmu_lR_dnl_jt =
          -3.0 * mu_vdW_jt / (n_l_jt * nS_jt) +
          (aug_active_jt
               ? -mu_aug_jt / (vdw_augmentation_decay_length * nS_jt *
                               nS_jt * rho_SR * specific_surface)
               : 0.0);  // J/kg per 1
      const auto dmu_lR_drho_lR_jt = -mu_vdW_jt / rho_lR_jt;  // J/kg per kg/m^3
      const auto omega_raw_jt = n_l_jt * rho_lR_jt / (nS_jt * rho_SR);
      const auto omega_clamped_jt = std::max(omega_raw_jt, minimum_n_l);
      const auto EOS_attr_jt =
          rho_l0 *
          std::exp(-density_a * std::pow(omega_clamped_jt, density_b));  // kg/m^3
      const auto domega_dnl_jt = (omega_raw_jt > minimum_n_l)
                                     ? rho_lR_jt / (rho_SR * nS_jt * nS_jt)
                                     : 0.0;
      const auto domega_drho_lR_jt = (omega_raw_jt > minimum_n_l)
                                         ? n_l_jt / (nS_jt * rho_SR)
                                         : 0.0;
      const auto deos_pref_jt =
          -EOS_attr_jt * density_a * density_b *
          std::pow(omega_clamped_jt, density_b - 1.0);  // kg/m^3
      const auto drho_eos_dnl_jt = deos_pref_jt * domega_dnl_jt;  // kg/m^3
      const auto drho_eos_drho_lR_jt = deos_pref_jt * domega_drho_lR_jt;  // 1
      const auto one_minus_deps_v_jt = 1.0 - delta_epsilon_v;
      const auto j11_jt = dphi_m_dnl_jt * rho_lR_jt * one_minus_deps_v_jt +
                          dt * alpha_eff * dmu_lR_dnl_jt;
      const auto j12_jt = phi_m_jt * one_minus_deps_v_jt +
                          dt * alpha_eff * dmu_lR_drho_lR_jt;
      const auto j21_jt = -drho_eos_dnl_jt;
      const auto j22_jt = 1.0 - drho_eos_drho_lR_jt;
      const auto det_jt = j11_jt * j22_jt - j12_jt * j21_jt;
      tfel::raise_if(std::abs(det_jt) < 1e-24,
                     "DSMMicroMacro outer-tangent Jacobian became singular.");

      // Analytical dn_l/deps_v via IFT: ∂r1/∂eps_v = -phi_m*rho_lR, ∂r2/∂eps_v = 0.
      const auto dn_l_dtrace_eps =
          phi_m_jt * rho_lR_jt * j22_jt / det_jt;  // 1

      // Swelling tangent factor ∂σ_sw/∂n_l_trial (dominant term):
      //   K>0:    -n_S_rev * Π_curr   (augmentation, dominant in dG/dn_l)
      //   else:   -K_bulk * slope     (slope-based eigenstress)
      // n_S_rev variation with n_l (subdominant) is neglected here; the macro
      // Newton converges with this approximation. If convergence is slow,
      // upgrade to the full chain rule on Π_prev and n_S_rev.
      real swelling_tangent_factor;
      if (vdw_augmentation_prefactor > 0.0 &&
          vdw_augmentation_decay_length > 0.0)
      {
        const auto phi_M_jt_tg = phi_M_from_nl(n_l_jt);
        const auto nS_rev_tg = std::max(minimum_n_l, 1.0 - phi_M_jt_tg);
        // Π uses MACRO liquid density (rho_LR_ref), not micro density.
        // See note in the stress-update block (porting bug fixed 2026-05-27).
        const auto rho_LR_safe_tg = rho_LR_ref;
        const auto aug_denom_tg = vdw_augmentation_decay_length *
                                  nS_rev_tg * rho_SR * specific_surface;
        const auto xi_curr_tg = n_l_jt / aug_denom_tg;
        const auto Pi_curr_tg =
            rho_LR_safe_tg * vdw_augmentation_prefactor *
            std::exp(-xi_curr_tg);  // Pa
        swelling_tangent_factor = -nS_rev_tg * Pi_curr_tg;  // Pa
      }
      else
      {
        swelling_tangent_factor = -bulk_modulus * swelling_slope;  // Pa
      }

      ∂sigma∕∂Δeps_to = ∂sigma∕∂Δeps_to +
                        (swelling_tangent_factor * dn_l_dtrace_eps) *
                            (I₂ ⊗ I₂);

      if (p > -pressure_tolerance)
      {
        ∂sigma∕∂Δp_LR = 0.0 * I₂;
        ∂S_L∕∂Δp_LR = 0.0;
      }
      else
      {
        // Analytical dn_l/dp via IFT (∂r1/∂p = -dt·alpha_eff/rho_macro_safe).
        // mu_macro_from_pressure uses rho_macro_safe = max(rho_lR_prev,
        // rho_LR_ref+gap), so the same denominator appears here.
        const auto rho_macro_safe_dp =
            std::max(rho_lR_prev, rho_LR_ref + minimum_density_gap);
        const auto dn_l_dp =
            dt * alpha_eff * j22_jt / (rho_macro_safe_dp * det_jt);  // 1 per Pa

        // Analytical dS_L/dp from the Tuller-Or curve (closed form).
        const auto capillary_prefactor =
            4.0 * pore_area_shape_factor_tuller *
            surface_tension * surface_tension /
            (area_factor_tuller * characteristic_pore_size *
             characteristic_pore_size);
        const auto capillary_term =
            capillary_prefactor / (p * p);
        const auto S_local = 1.0 - std::exp(-capillary_term);
        const auto dS_dp =
            -2.0 * (1.0 - S_local) * capillary_prefactor /
            (p * p * p);  // 1/Pa  (positive for p<0)

        ∂sigma∕∂Δp_LR = (swelling_tangent_factor * dn_l_dp) * I₂;
        ∂S_L∕∂Δp_LR = dS_dp;
      }
    }
  }
}

@UpdateAuxiliaryStateVariables
{
  constexpr const auto minimum_n_l = 1e-14;

  // Hierarchical porosity split: phi_M = (phi0-n_l)/(1-n_l), phi_m = n_l*(1-phi_M)
  // (phi_m and phi_M values reported back to OGS; consistent with @Integrator's
  //  phi_M_from_nl/phi_m_from_nl.)
  const auto phi_M_updated = std::clamp((phi0 - std::max(minimum_n_l, n_l)) /
                                        (1.0 - std::max(minimum_n_l, n_l)), 0.0, phi0);
  phi_m = n_l * (1.0 - phi_M_updated);  // = n_l*(1-phi0)/(1-n_l) in unclamped regime
  phi_M = phi_M_updated;

  // mu_lR_value and rho_l_hat_value are already set correctly in @Integrator
  // from the converged solve_microstate result (using end-of-step pressure).
  // Do NOT recompute them here:
  //   * @UpdateAuxiliaryStateVariables receives p_LR as the beginning-of-step
  //     value in the OGS-MFront coupling, which would give the wrong exchange
  //     rate for rho_l_hat.
  //   * A prior version of this block recomputed mu_lR_value using
  //     active_nS_updated = (1-phi0)/(1-n_l), which is the PRE-2026-05-26-fix
  //     definition and inconsistent with @Integrator's active_nS_from_nl(n_l)
  //     = 1 - n_l. The recomputation also omitted the K*exp(-xi) augmentation
  //     added with the parameter port. Preserving the @Integrator value avoids
  //     both bugs (single source of truth).
  // Leave mu_lR_value and rho_l_hat_value unchanged (already set in @Integrator
  // around lines 596-597 after the augmentation port).
}
