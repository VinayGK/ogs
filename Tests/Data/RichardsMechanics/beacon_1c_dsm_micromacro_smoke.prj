<?xml version="1.0" encoding="ISO-8859-1"?>
<OpenGeoSysProject>
<!--
  Benchmark provenance and parameter notes.

  Benchmark family    : Beacon (geometry lineage only). No BEACON
                         specification document with a citable table or
                         figure locator has been identified for this
                         configuration.
  Geometry / BC        : axisymmetric cell on beacon_1c_domain.vtu, two
                         solid materials (block and pellet) represented
                         across four medium blocks, initial pressure
                         -1e6 Pa, top_pressure 1e4 Pa, bottom_pressure
                         0 Pa, t_end = 1e3 s.
  Purpose              : two-material micro-macro exchange plumbing smoke
                         test; the Pi-path potential-exchange term is
                         inactive (no potential_augmentation_prefactor
                         tag; van der Waals augmentation switched off).
  Material sharing     : the block and pellet media share grain density,
                         elastic constants (E, nu), the Biot coefficient,
                         the Bishop's-effective-stress formulation and
                         the liquid-phase properties, while porosity,
                         permeability, swelling pressure and specific
                         surface differ between the two.

  Calibration anchor:
    source             : none; this deck performs no calibration.
    dataset row         : n/a
    target sigma        : n/a
    fitted K            : none. No potential_augmentation_prefactor tag is
                         present, so K defaults to 0.0 and the
                         augmentation branch is skipped
                         (PotentialExchange.h:259: "Setting K = 0
                         (default) reduces exactly to the pure vdW
                         form"). The swelling_pressures literals below
                         are inputs to the macro
                         SaturationDependentSwelling law; they are model
                         inputs, not calibration targets.

  Material parameters (source per group):
    elastic nu (0.2)            : documented, family not settled. D3.3 PDF
                                  p.66, Table 2 "Mechanical parameters", row
                                  "Poisson's Ratio" = 0.2 (-). Matches this
                                  deck's live value exactly; this entry
                                  documents the literal already present and
                                  changes nothing. Source: BEACON Deliverable
                                  D3.3, "Description of the constitutive
                                  models developed in the project. Conceptual
                                  bases, mathematical description and model
                                  capabilities. Assessment of predictive
                                  power"; its title page reads "Author:
                                  Antonio Gens", with contributions by V.
                                  Kumar (this repo's owner), S. Beese, D.
                                  Masin and others; Euratom research and
                                  training programme 2014-2018, grant
                                  agreement No 745 942; deliverable dated
                                  31/10/21. Table 2 sits in the annex whose
                                  footer reads "D3.3 - BGR Results of Task
                                  3.3", dissemination level PU, date of issue
                                  08/09/2021. Relayed, not originated: the
                                  same page states that the mechanical
                                  parameters used in the simulations of the
                                  two stress paths are based on values stated
                                  in Akesson et al. 2010, so D3.3 Table 2
                                  restates nu rather than originating it, and
                                  that sentence's scope is D3.3's own two
                                  stress paths, not this deck. D3.3's own
                                  reference list, PDF p.72, identifies that
                                  citation as SKB TR-10-44, "SR-Site Data
                                  report. THM modelling of buffer, backfill
                                  and other system component", Akesson,
                                  Borgesson and Kristensson 2010 (names
                                  written ASCII here; the source spells them
                                  with Nordic diacritics). The TR-10-44 PDF
                                  itself is not on this machine, but a full
                                  text extraction of it is: eurad-anchors
                                  subtask41, audits, folder
                                  2026-09-03_E_vs_rhod_search_successful,
                                  lane4/txt, file
                                  SKB_SRSite_data_Akesson2010.txt. That file's
                                  own title page and running headers read
                                  "SR-Site Data report - THM modelling of
                                  buffer, backfill and other system
                                  components", "TR-10-44", "ISSN 1404-0344",
                                  authors Akesson, Borgesson, Kristensson,
                                  March 2010 - matching D3.3's reference-list
                                  entry exactly. Its Section 12.1 "Code_Bright
                                  data for MX-80", Table 12-1 "Data used for
                                  different MX-80 buffer materials
                                  (Code_Bright)" (compacted bentonite buffer:
                                  ring/block/pellets, not backfill), spanning
                                  the report's own pp. 80-81, carries
                                  Poisson's ratio 0.2, listed once across the
                                  ring, block and pellet columns. Do not
                                  confuse this file with its neighbour in the
                                  same folder, SKB_TR-10-11_Akesson2010.txt:
                                  that is a DIFFERENT SKB report (TR-10-11,
                                  "THM modelling of buffer, backfill and other
                                  system components - Critical processes and
                                  scenarios", Akesson, Kristensson, Borgesson,
                                  Dueck and Hernelind); an earlier version of
                                  this header cited that report's Tab. 7-1 /
                                  Tab. 16-3 (both backfill-material rows) for
                                  this citation, which was wrong on two counts
                                  at once: wrong report and wrong material.
                                  D3.3 does not name which TR-10-44 table it
                                  drew on, so the exact upstream row stays
                                  unestablished. Family: 12.1 family 1
                                  (Beacon) is the candidate, not a settled
                                  classification. Family 1 reads "Beacon
                                  project benchmark spec / Beacon experimental
                                  reports", while D3.3 is a constitutive model
                                  description deliverable reporting parameters
                                  used in a simulation. That call is Vinay's.
                                  Shared by block and pellet.
    elastic E (50e6 Pa)         : not tied to a cited source (E = 50e6 Pa),
                                  shared by block and pellet; unchanged by
                                  this entry and still uncited. D3.3 Table 2
                                  cited above gives E = 180 MPa, which is NOT
                                  this deck's value and therefore does not
                                  document it.
    porosity split phi0/phi_tr  : not tied to a cited source (block
                                  0.35 / 0.25, pellet 0.675 / 0.55). The
                                  pellet value 0.675 is numerically close
                                  to, but distinct from, the EURAD-2
                                  MS33 pellet porosity value 0.676259
                                  (= 1 - 900/2780); the similarity is
                                  coincidental, and this value is not
                                  sourced from that benchmark.
    intrinsic permeability      : not tied to a cited source (block
                                  1e-18 m2, pellet 1e-15 m2).
    retention macro (Sr,m,p_b)  : not tied to a cited source (block
                                  1e6 Pa, pellet 5e5 Pa; m = 0.5).
    retention micro (Sr,m,p_b)  : not tied to a cited source (block
                                  1e7 Pa, pellet 5e6 Pa; m = 0.5).
    swelling law (p_sw, expts)  : not tied to a cited source (block
                                  1.3e7 Pa, pellet 0.8e7 Pa; exponents
                                  1 1 1).
    solid density rho_s         : not tied to a cited source (2780
                                  kg/m3). This value is close to, but
                                  not confirmed as sourced from, a
                                  grain-density figure given in the
                                  EURAD-2 MS33 specification narrative
                                  text (theoretical_benchmarking.tex,
                                  line 102, quoted there as
                                  approximately 2.78 g/cm3); the
                                  specification's benchmark table does
                                  not itself list a solid density, so
                                  the similarity is not adopted as the
                                  source. This file additionally
                                  specifies
                                  micro_solid_density_reference = 2650
                                  kg/m3, a distinct grain density about
                                  4.7 percent different from the 2780
                                  kg/m3 above.
    micro reference state       : not tied to a cited source (rho_SR_m
                                  = 2650 kg/m3, nS_ref, n_l0). The value
                                  2650 kg/m3 coincides with a reported
                                  grain density for Boom Clay (GRS-202),
                                  an unrelated material; this
                                  coincidence is noted so it is not
                                  mistaken for a source of this
                                  parameter.
    fluid properties            : not tied to a cited source
                                  (viscosity 1e-3 Pa s, density 1e3
                                  kg/m3). These are rounded working
                                  values, not the IAPWS-95 reference
                                  figures at 293.15 K (1.002e-3 Pa s,
                                  998.21 kg/m3).
    biot_coefficient            : not tied to a cited source (1.0);
                                  reflects an incompressible-mineral
                                  assumption rather than a direct
                                  measurement.
    mass transfer alpha_M       : not tied to a cited source (1e-13);
                                  phenomenological and fabric-dependent,
                                  and not identified by a
                                  swelling-pressure calibration
                                  (fast-exchange limit).
    reference temperature       : not tied to a cited source (293.15
                                  K); inert in this isothermal
                                  benchmark.
    BC / IC magnitudes          : not tied to a cited source. Suction
                                  initial conditions, hydraulic
                                  Dirichlet values, sigma0 (all zero)
                                  and the zero body force are working
                                  values. The EURAD-2 MS33
                                  specification's initial suction is
                                  100 MPa, that is, 100 times these
                                  values, so nothing here is inherited
                                  from that specification.
    macro_porosity_floor and
    micro_water_content_floor   : 0.0 / 0.0, numerical and inert; both
                                  keys must be declared together, and a
                                  floor of 0.0 reproduces the unfloored
                                  path (PotentialExchange.h:199-205).
    micro EOS (a, b, rho_l0)    : not tied to a cited source (1.3 /
                                  1.0 / 1300). The micro liquid-density
                                  equation of state is active here
                                  (a = 1.3), unlike the a = 1e-16
                                  bypass value used in some other
                                  configurations in this suite.
    vdW base A_Hamaker          : numerical placeholder, term switched
                                  off (A = 1e-30 J); not the literature
                                  value of 2.2e-20 J used for this
                                  constant in other configurations.
    specific surface Sa         : not tied to a cited source. Global
                                  placeholder 1.0 m2/kg with per-medium
                                  overrides 0.8 (block) and 1.5
                                  (pellet). These values are independent
                                  of, and must not be attributed to, the
                                  EPFL/Seiphoori specific-surface
                                  measurement (523 m2/g) used elsewhere
                                  in this suite.

  Known configuration notes:
    1. bishops_effective_stress uses BishopsPowerLaw(exponent=1); other
       configurations in this benchmark family use
       BishopsSaturationCutoff(cutoff=1).
    2. The pressure convergence tolerance (abstol = 5e-8 Pa) is tight
       relative to the 1e6 Pa pressure/suction scale used here, with no
       relative tolerances set.
    3. The unit of the mass-transfer coefficient (alpha_M) is not
       documented in the code's own interface comment; no unit is
       asserted here.
-->
    <mesh axially_symmetric="true">beacon_1c_domain.vtu</mesh>
    <geometry>beacon_1c.gml</geometry>
    <processes>
        <process>
            <name>RM</name>
            <type>RICHARDS_MECHANICS</type>
            <integration_order>2</integration_order>
            <micro_porosity>
                <mass_exchange_coefficient>1e-13</mass_exchange_coefficient>
                <nonlinear_solver><maximum_iterations>100</maximum_iterations><residuum_tolerance>1e-8</residuum_tolerance><increment_tolerance>1e-20</increment_tolerance></nonlinear_solver>
            </micro_porosity>
            <potential_exchange>
                <enabled>true</enabled>
                <pressure_tolerance>0.0</pressure_tolerance>
                <hamaker_constant>1e-30</hamaker_constant>
                <specific_surface>1.0</specific_surface>
                <micro_solid_density_reference>2650</micro_solid_density_reference>
                <micro_solid_volume_fraction_reference>0.6</micro_solid_volume_fraction_reference>
                <initial_micro_water_content>0.1</initial_micro_water_content>
                <!-- Micro-liquid-density EOS metadata matches that used in a related
                     smoke-test configuration in this suite, chosen so the scalar
                     micro-macro mass-storage path remains well posed for this medium. -->
                <micro_liquid_density_reference>1300</micro_liquid_density_reference>
                <micro_liquid_density_a>1.3</micro_liquid_density_a>
                <micro_liquid_density_b>1.0</micro_liquid_density_b>
                <fd_jacobian_for_exchange>false</fd_jacobian_for_exchange>
                <medium id="0">
                    <specific_surface>0.8</specific_surface>
                    <micro_solid_volume_fraction_reference>0.65</micro_solid_volume_fraction_reference>
                    <initial_micro_water_content>0.08</initial_micro_water_content>
                    <micro_liquid_density_reference>1300</micro_liquid_density_reference>
                    <micro_liquid_density_a>1.3</micro_liquid_density_a>
                    <micro_liquid_density_b>1.0</micro_liquid_density_b>
                </medium>
                <medium id="1">
                    <specific_surface>1.5</specific_surface>
                    <micro_solid_volume_fraction_reference>0.45</micro_solid_volume_fraction_reference>
                    <initial_micro_water_content>0.14</initial_micro_water_content>
                    <micro_liquid_density_reference>1300</micro_liquid_density_reference>
                    <micro_liquid_density_a>1.3</micro_liquid_density_a>
                    <micro_liquid_density_b>1.0</micro_liquid_density_b>
                </medium>
                            <!-- Floors declared inert (0.0 = no floor); both keys must be present
                     together for the parser to accept this configuration, and a
                     floor of 0.0 reproduces the unfloored path, consistent with
                     other EURAD-2 MS33 benchmark configurations. -->
                <macro_porosity_floor>0.0</macro_porosity_floor>
                <micro_water_content_floor>0.0</micro_water_content_floor>
            </potential_exchange>
            <constitutive_relation id="0,1"><type>LinearElasticIsotropic</type><youngs_modulus>E</youngs_modulus><poissons_ratio>nu</poissons_ratio></constitutive_relation>
            <process_variables><pressure>pressure</pressure><displacement>displacement</displacement></process_variables>
            <secondary_variables>
                <secondary_variable name="sigma"/><secondary_variable name="swelling_stress"/><secondary_variable name="epsilon"/><secondary_variable name="velocity"/><secondary_variable name="saturation"/><secondary_variable name="porosity"/><secondary_variable name="transport_porosity"/><secondary_variable name="dry_density_solid"/><secondary_variable name="micro_saturation"/><secondary_variable name="micro_pressure"/>
            </secondary_variables>
            <specific_body_force>0 0</specific_body_force>
            <initial_stress>sigma0</initial_stress>
            <mass_lumping>true</mass_lumping>
        </process>
    </processes>
    <media>
        <medium id="0">
            <phases>
                <phase><type>AqueousLiquid</type><properties><property><name>viscosity</name><type>Constant</type><value>1e-3</value></property><property><name>density</name><type>Constant</type><value>1e3</value></property></properties></phase>
                <phase><type>Solid</type><properties><property><name>density</name><type>Constant</type><value>2780</value></property><property><name>swelling_stress_rate</name><type>SaturationDependentSwelling</type><swelling_pressures>1.3e7 1.3e7 1.3e7</swelling_pressures><exponents>1 1 1</exponents><lower_saturation_limit>0</lower_saturation_limit><upper_saturation_limit>1</upper_saturation_limit></property></properties></phase>
            </phases>
            <properties>
                <property><name>transport_porosity</name><type>TransportPorosityFromMassBalance</type><initial_porosity>phi_tr0_block</initial_porosity><minimal_porosity>0</minimal_porosity><maximal_porosity>1</maximal_porosity></property>
                <property><name>biot_coefficient</name><type>Constant</type><value>1.0</value></property>
                <property><name>permeability</name><type>Constant</type><value>1e-18</value></property>
                <property><name>porosity</name><type>PorosityFromMassBalance</type><initial_porosity>phi0_block</initial_porosity><minimal_porosity>0</minimal_porosity><maximal_porosity>1</maximal_porosity></property>
                <property><name>reference_temperature</name><type>Constant</type><value>293.15</value></property>
                <property><name>relative_permeability</name><type>Constant</type><value>1</value></property>
                <property><name>saturation</name><type>SaturationVanGenuchten</type><residual_liquid_saturation>0.0</residual_liquid_saturation><residual_gas_saturation>0</residual_gas_saturation><exponent>0.5</exponent><p_b>1e6</p_b></property>
                <property><name>saturation_micro</name><type>SaturationVanGenuchten</type><residual_liquid_saturation>0</residual_liquid_saturation><residual_gas_saturation>0</residual_gas_saturation><exponent>0.5</exponent><p_b>1e7</p_b></property>
                <property><name>bishops_effective_stress</name><type>BishopsPowerLaw</type><exponent>1</exponent></property>
            </properties>
        </medium>
        <medium id="1">
            <phases>
                <phase><type>AqueousLiquid</type><properties><property><name>viscosity</name><type>Constant</type><value>1e-3</value></property><property><name>density</name><type>Constant</type><value>1e3</value></property></properties></phase>
                <phase><type>Solid</type><properties><property><name>density</name><type>Constant</type><value>2780</value></property><property><name>swelling_stress_rate</name><type>SaturationDependentSwelling</type><swelling_pressures>0.8e7 0.8e7 0.8e7</swelling_pressures><exponents>1 1 1</exponents><lower_saturation_limit>0</lower_saturation_limit><upper_saturation_limit>1</upper_saturation_limit></property></properties></phase>
            </phases>
            <properties>
                <property><name>transport_porosity</name><type>TransportPorosityFromMassBalance</type><initial_porosity>phi_tr0_pellet</initial_porosity><minimal_porosity>0</minimal_porosity><maximal_porosity>1</maximal_porosity></property>
                <property><name>biot_coefficient</name><type>Constant</type><value>1.0</value></property>
                <property><name>permeability</name><type>Constant</type><value>1e-15</value></property>
                <property><name>porosity</name><type>PorosityFromMassBalance</type><initial_porosity>phi0_pellet</initial_porosity><minimal_porosity>0</minimal_porosity><maximal_porosity>1</maximal_porosity></property>
                <property><name>reference_temperature</name><type>Constant</type><value>293.15</value></property>
                <property><name>relative_permeability</name><type>Constant</type><value>1</value></property>
                <property><name>saturation</name><type>SaturationVanGenuchten</type><residual_liquid_saturation>0.0</residual_liquid_saturation><residual_gas_saturation>0</residual_gas_saturation><exponent>0.5</exponent><p_b>5e5</p_b></property>
                <property><name>saturation_micro</name><type>SaturationVanGenuchten</type><residual_liquid_saturation>0</residual_liquid_saturation><residual_gas_saturation>0</residual_gas_saturation><exponent>0.5</exponent><p_b>5e6</p_b></property>
                <property><name>bishops_effective_stress</name><type>BishopsPowerLaw</type><exponent>1</exponent></property>
            </properties>
        </medium>
    </media>
    <time_loop>
        <processes><process ref="RM"><nonlinear_solver>nonlinear_solver</nonlinear_solver><convergence_criterion><norm_type>NORM2</norm_type><type>PerComponentDeltaX</type><abstols>5e-8 1e-13 1e-13</abstols></convergence_criterion><time_discretization><type>BackwardEuler</type></time_discretization><time_stepping><type>FixedTimeStepping</type><t_initial>0.0</t_initial><t_end>1e3</t_end><timesteps><pair><repeat>20</repeat><delta_t>50</delta_t></pair></timesteps></time_stepping></process></processes>
        <output><type>VTK</type><prefix>beacon_1c_dsm_micromacro_smoke</prefix><suffix>_t_{:time}</suffix><fixed_output_times>1e3</fixed_output_times><variables><variable>pressure</variable><variable>displacement</variable><variable>saturation</variable><variable>porosity</variable><variable>transport_porosity</variable><variable>micro_pressure</variable><variable>micro_saturation</variable><variable>swelling_stress</variable><variable>sigma</variable></variables></output>
    </time_loop>
    <parameters>
        <parameter><name>sigma0</name><type>Function</type><expression>0</expression><expression>0</expression><expression>0</expression><expression>0</expression></parameter>
        <parameter><name>E</name><type>Constant</type><value>50e6</value></parameter>
        <parameter><name>nu</name><type>Constant</type><value>0.2</value></parameter>
        <parameter><name>phi0_block</name><type>Constant</type><value>0.35</value></parameter>
        <parameter><name>phi_tr0_block</name><type>Constant</type><value>0.25</value></parameter>
        <parameter><name>phi0_pellet</name><type>Constant</type><value>0.675</value></parameter>
        <parameter><name>phi_tr0_pellet</name><type>Constant</type><value>0.55</value></parameter>
        <parameter><name>displacement0</name><type>Constant</type><values>0 0</values></parameter>
        <parameter><name>pressure_ic</name><type>Constant</type><values>-1e6</values></parameter>
        <parameter><name>dirichlet0</name><type>Constant</type><value>0</value></parameter>
        <parameter><name>top_pressure</name><type>Constant</type><value>1e4</value></parameter>
        <parameter><name>bottom_pressure</name><type>Constant</type><value>0</value></parameter>
    </parameters>
    <process_variables>
        <process_variable><name>displacement</name><components>2</components><order>1</order><initial_condition>displacement0</initial_condition><boundary_conditions>
            <boundary_condition><geometrical_set>beacon_1c_geometry</geometrical_set><geometry>left</geometry><type>Dirichlet</type><component>0</component><parameter>dirichlet0</parameter></boundary_condition>
            <boundary_condition><geometrical_set>beacon_1c_geometry</geometrical_set><geometry>right</geometry><type>Dirichlet</type><component>0</component><parameter>dirichlet0</parameter></boundary_condition>
            <boundary_condition><geometrical_set>beacon_1c_geometry</geometrical_set><geometry>bottom</geometry><type>Dirichlet</type><component>1</component><parameter>dirichlet0</parameter></boundary_condition>
            <boundary_condition><geometrical_set>beacon_1c_geometry</geometrical_set><geometry>top</geometry><type>Dirichlet</type><component>1</component><parameter>dirichlet0</parameter></boundary_condition>
        </boundary_conditions></process_variable>
        <process_variable><name>pressure</name><components>1</components><order>1</order><initial_condition>pressure_ic</initial_condition><boundary_conditions>
            <boundary_condition><geometrical_set>beacon_1c_geometry</geometrical_set><geometry>top</geometry><type>Dirichlet</type><component>0</component><parameter>top_pressure</parameter></boundary_condition>
            <boundary_condition><geometrical_set>beacon_1c_geometry</geometrical_set><geometry>bottom</geometry><type>Dirichlet</type><component>0</component><parameter>bottom_pressure</parameter></boundary_condition>
        </boundary_conditions></process_variable>
    </process_variables>
    <nonlinear_solvers><nonlinear_solver><name>nonlinear_solver</name><type>Newton</type><max_iter>30</max_iter><linear_solver>general_linear_solver</linear_solver></nonlinear_solver></nonlinear_solvers>
    <linear_solvers><linear_solver><name>general_linear_solver</name><eigen><solver_type>SparseLU</solver_type><scaling>true</scaling></eigen></linear_solver></linear_solvers>
</OpenGeoSysProject>
